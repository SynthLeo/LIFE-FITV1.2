<file path="backend/Api/ia/Diagnostico.php">
<?php
// ============================================================
//  POST Api/IA/Diagnostico.php — diagnóstico del onboarding
//
//  Lee los 4 cuestionarios ya guardados, arma un RESUMEN
//  (no manda las respuestas crudas) y pide a la IA un JSON
//  con esquema. Si la IA falla, responde un diagnóstico básico
//  calculado aquí, para que el onboarding nunca se quede trabado.
// ============================================================

require_once __DIR__ . '/../../Seguridad/Cors.php';
require_once __DIR__ . '/../../Seguridad/Autenticacion.php';
require_once __DIR__ . '/../../utils/api.php';
require_once __DIR__ . '/../../utils/instrumentos.php';
require_once __DIR__ . '/../../ia/llm.php';
require_once __DIR__ . '/../../ia/prompts.php';

exigirMetodo('POST');

$uid = (int) $GLOBALS['userId'];
$db  = getDB();

$leer = function (string $sql) use ($db, $uid) {
    $st = $db->prepare($sql);
    $st->execute([$uid]);
    return $st->fetch() ?: [];
};
$ej = $leer('SELECT nivel_recomendado, ipaq_categoria, ipaq_met_min, parq_resultado, ipaq_sentado FROM cuestionario_habitos WHERE id_usuario = ?');
$cl = $leer('SELECT nivel_salud, salud_score, presion_dx, glucosa_dx, colesterol_dx, sueno_horas, tabaco_actual, vapeo_actual, chequeo_ultimo, vacunas FROM cuestionarios_clinicos WHERE usuario_id = ?');
$ps = $leer('SELECT nivel_psicologico, metas_bienestar FROM cuestionarios_psicologicos WHERE usuario_id = ?');
$al = $leer('SELECT nivel_nutricion, nutricion_score, objetivo FROM cuestionarios_alimentacion WHERE usuario_id = ?');
$us = $leer('SELECT nombre, peso_kg, altura_cm, fecha_nacimiento FROM usuario WHERE id_usuario = ?');

$imc = (!empty($us['peso_kg']) && !empty($us['altura_cm'])) ? round($us['peso_kg'] / (($us['altura_cm'] / 100) ** 2), 1) : null;
$resumen = [
    'edad'       => edadDesde($us['fecha_nacimiento'] ?? null),
    'imc'        => $imc,
    'ejercicio'  => ['nivel' => $ej['nivel_recomendado'] ?? null, 'actividad_ipaq' => $ej['ipaq_categoria'] ?? null, 'met_min_semana' => $ej['ipaq_met_min'] ?? null, 'par_q' => $ej['parq_resultado'] ?? null, 'horas_sentado' => $ej['ipaq_sentado'] ?? null],
    'clinico'    => ['nivel' => $cl['nivel_salud'] ?? null, 'puntaje' => $cl['salud_score'] ?? null, 'presion' => $cl['presion_dx'] ?? null, 'glucosa' => $cl['glucosa_dx'] ?? null, 'sueno' => $cl['sueno_horas'] ?? null, 'tabaco' => $cl['tabaco_actual'] ?? null, 'vapeo' => $cl['vapeo_actual'] ?? null, 'ultimo_chequeo' => $cl['chequeo_ultimo'] ?? null],
    'nutricion'  => ['nivel' => $al['nivel_nutricion'] ?? null, 'puntaje' => $al['nutricion_score'] ?? null, 'objetivo' => $al['objetivo'] ?? null],
    'psicologia' => ['bienestar' => $ps['nivel_psicologico'] ?? null, 'meta' => $ps['metas_bienestar'] ?? null],
];

// ── Diagnóstico de respaldo (sin IA) ──────────────────────────
function diagnosticoBasico(array $r): array {
    $ejN = ['principiante' => 'Principiante', 'intermedio' => 'Intermedio', 'avanzado' => 'Avanzado'][$r['ejercicio']['nivel'] ?? ''] ?? 'Principiante';
    $clN = ['optimo' => 'Óptimo', 'bueno' => 'Bueno'][$r['clinico']['nivel'] ?? ''] ?? 'Atención requerida';
    $nuN = ['optimo' => 'Excelente', 'adecuado' => 'Adecuada'][$r['nutricion']['nivel'] ?? ''] ?? 'Mejorable';
    $psN = ['resiliente' => 'Estable', 'moderado' => 'Moderado'][$r['psicologia']['bienestar'] ?? ''] ?? 'Requiere apoyo';
    $prioridad = $psN === 'Requiere apoyo' ? 'psicologia' : ($clN === 'Atención requerida' ? 'clinico' : ($nuN === 'Mejorable' ? 'nutricion' : 'ejercicio'));
    return [
        'resumen' => 'Ya tenemos tu perfil de salud. Revisa cada módulo para ver tus recomendaciones y empieza por tu prioridad.',
        'modulos' => [
            'ejercicio'  => ['nivel' => $ejN, 'observacion' => 'Tu nivel se calculó con tu actividad de los últimos 7 días (IPAQ).', 'recomendacion' => ($r['ejercicio']['par_q'] ?? '') === 'consultar' ? 'Consulta a un profesional antes de subir la intensidad.' : 'Sigue tu rutina y aumenta la carga poco a poco.'],
            'clinico'    => ['nivel' => $clN, 'observacion' => 'Calculado con tus hábitos y antecedentes de salud.', 'recomendacion' => 'Hazte un chequeo preventivo al año.'],
            'nutricion'  => ['nivel' => $nuN, 'observacion' => 'Calculado con tus hábitos de alimentación de la semana.', 'recomendacion' => 'Revisa tu plan semanal en el módulo de Nutrición.'],
            'psicologia' => ['nivel' => $psN, 'observacion' => 'Basado en el tamizaje de ánimo y ansiedad de las últimas 2 semanas.', 'recomendacion' => $psN === 'Requiere apoyo' ? 'Te recomendamos agendar una cita en el módulo de Psicología.' : 'Practica alguna técnica de bienestar esta semana.'],
        ],
        'prioridad'        => $prioridad,
        'frase_motivadora' => 'Cada pequeño paso cuenta. ¡Vamos!',
        'generado_por'     => 'reglas',
    ];
}

$diag = null;
if (llmPermitido($uid, 'diagnostico')) {
    $r = llmChat(promptDiagnostico($resumen), [
        'temperature'   => 0.4,
        'max_tokens'    => 900,
        'timeout'       => 150,
        'json_schema'   => esquemaDiagnostico(),
        'nombre_schema' => 'diagnostico',
    ]);
    $j = $r['ok'] ? ($r['json'] ?? llmExtraerJSON($r['content'])) : null;
    $base = diagnosticoBasico($resumen);
    if (is_array($j) && isset($j['modulos']) && is_array($j['modulos'])) {
        // Se valida campo por campo; lo que no cumpla se toma del diagnóstico básico
        $diag = $base;
        $diag['generado_por'] = 'ia';
        if (is_string($j['resumen'] ?? null))          $diag['resumen'] = mb_substr(strip_tags($j['resumen']), 0, 500);
        if (is_string($j['frase_motivadora'] ?? null)) $diag['frase_motivadora'] = mb_substr(strip_tags($j['frase_motivadora']), 0, 150);
        if (in_array($j['prioridad'] ?? null, ['ejercicio', 'clinico', 'nutricion', 'psicologia'], true)) $diag['prioridad'] = $j['prioridad'];
        foreach (['observacion', 'recomendacion'] as $campo) {
            foreach ($diag['modulos'] as $m => $_) {
                if (is_string($j['modulos'][$m][$campo] ?? null)) $diag['modulos'][$m][$campo] = mb_substr(strip_tags($j['modulos'][$m][$campo]), 0, 300);
            }
        }
        // Los NIVELES salen de los instrumentos, no del modelo
        // Seguridad: si el tamizaje marcó apoyo, la IA no puede bajarle la prioridad
        if ($base['modulos']['psicologia']['nivel'] === 'Requiere apoyo') $diag['prioridad'] = 'psicologia';
    } else {
        error_log('[Diagnostico] IA sin JSON válido: ' . ($r['error'] ?? 'formato'));
    }
}

salir(200, ['ok' => true, 'diagnostico' => $diag ?? diagnosticoBasico($resumen)]);
</file>

<file path="backend/Api/ia/GenerarDieta.php">
<?php
// ============================================================
//  POST Api/IA/GenerarDieta.php — plan semanal de comidas con IA
//
//  Body (todo opcional):
//   { respuestas: {…respuestas del cuestionario de alimentación…},
//     guardar: true }
//  - Sin "respuestas": usa el perfil guardado del usuario.
//  - Con "guardar": actualiza solo plan_semanal (si el perfil ya existe).
//
//  El prompt se arma en el servidor, el modelo responde con JSON
//  según un esquema, y el plan se valida antes de devolverlo.
//  Calorías: Mifflin-St Jeor × actividad, nunca menos de 1,400.
// ============================================================

require_once __DIR__ . '/../../Seguridad/Cors.php';
require_once __DIR__ . '/../../Seguridad/Autenticacion.php';
require_once __DIR__ . '/../../utils/api.php';
require_once __DIR__ . '/../../utils/instrumentos.php';
require_once __DIR__ . '/../../utils/dieta.php';
require_once __DIR__ . '/../../utils/helpers.php';
require_once __DIR__ . '/../../ia/llm.php';
require_once __DIR__ . '/../../ia/prompts.php';

exigirMetodo('POST');

$uid  = (int) $GLOBALS['userId'];
$body = jsonBody();
$db   = getDB();

// ── 1. Contexto: respuestas recién contestadas o perfil guardado ──
try {
    if (!empty($body['respuestas']) && is_array($body['respuestas'])) {
        $ctx = limpiarRespuestas('alimentacion', $body['respuestas']);
    } else {
        $st = $db->prepare('SELECT * FROM cuestionarios_alimentacion WHERE usuario_id = ? LIMIT 1');
        $st->execute([$uid]);
        $fila = $st->fetch();
        if (!$fila) salir(422, ['error' => 'Primero completa el cuestionario de alimentación.']);
        $ctx = limpiarRespuestas('alimentacion', $fila);
    }
} catch (InvalidArgumentException $e) {
    salir(422, ['error' => $e->getMessage()]);
}

// ── 2. Calorías objetivo (si hay peso y altura) ───────────────
$st = $db->prepare('SELECT peso_kg, altura_cm, fecha_nacimiento, sexo_biologico FROM usuario WHERE id_usuario = ?');
$st->execute([$uid]);
$u = $st->fetch() ?: [];
$kcalObjetivo = null;
if (!empty($u['peso_kg']) && !empty($u['altura_cm'])) {
    $tmb    = calcularTMB((float) $u['peso_kg'], (int) $u['altura_cm'], calcularEdad($u['fecha_nacimiento'] ?? null), $u['sexo_biologico'] ?? null);
    $factor = ['sedentario' => 1.2, 'leve' => 1.375, 'moderado' => 1.55, 'intenso' => 1.725][$ctx['actividad_fisica_alim'] ?? ''] ?? 1.375;
    $ajuste = ['perder_peso' => 0.85, 'ganar_masa' => 1.10][$ctx['objetivo'] ?? ''] ?? 1.0;   // déficit moderado, nunca agresivo
    $edadU  = calcularEdad($u['fecha_nacimiento'] ?? null);
    if ($edadU !== null && $edadU < 18 && $ajuste < 1.0) $ajuste = 1.0;   // menores: sin déficit calórico (siguen creciendo)
    $kcalObjetivo = (int) (round(max(KCAL_MINIMO_SEGURO, min(3200, $tmb * $factor * $ajuste)) / 50) * 50);
}

// ── 3. Hábitos a mejorar (preguntas con 0 o 1 punto) ──────────
$textos = [
    'verduras_dias' => 'más verduras', 'frutas_dias' => 'más fruta', 'lacteos_dias' => 'lácteos naturales',
    'agua_vasos' => 'más agua natural', 'carnes_procesadas' => 'menos embutidos', 'comida_rapida' => 'menos comida rápida',
    'dulces' => 'menos dulces', 'pan_dulce' => 'menos pan dulce', 'botanas' => 'menos botanas',
    'refrescos_dias' => 'menos refresco', 'desayuno_dias' => 'desayunar diario',
];
$habitos = [];
foreach ($textos as $id => $t) {
    if (($ctx[$id] ?? null) !== null && (int) opcionDato('alimentacion', $id, $ctx) <= 1) $habitos[] = $t;
}

// ── 4. IA ─────────────────────────────────────────────────────
if (!llmPermitido($uid, 'dieta')) salir(429, ['error' => 'Espera un minuto antes de generar otro plan.']);

$menorDeEdad = isset($edadU) && $edadU !== null && $edadU < 18;
if ($menorDeEdad && ($ctx['objetivo'] ?? '') === 'perder_peso') $ctx['objetivo'] = 'mejorar_salud';
$mensajes = promptDieta($ctx + ['kcal_objetivo' => $kcalObjetivo, 'habitos' => implode(', ', array_slice($habitos, 0, 5))]);
$plan  = null;
$ultimoError = '';
for ($intento = 1; $intento <= 2 && $plan === null; $intento++) {
    $r = llmChat($mensajes, [
        'temperature'   => 0.4,
        'max_tokens'    => 3000,
        'timeout'       => 240,
        'json_schema'   => esquemaPlanDieta(),
        'nombre_schema' => 'plan_semanal',
    ]);
    if (!$r['ok']) { $ultimoError = $r['error']; break; }   // si LM Studio no responde, no tiene caso reintentar
    try {
        $plan = validarPlanDieta($r['json'] ?? llmExtraerJSON($r['content']));
    } catch (InvalidArgumentException $e) {
        $ultimoError = $e->getMessage();
        error_log("[GenerarDieta] intento $intento inválido: $ultimoError");
    }
}
if ($plan === null) {
    error_log('[GenerarDieta] ' . $ultimoError);
    salir(503, ['error' => 'No se pudo generar el plan. Revisa que LM Studio esté corriendo e intenta de nuevo.']);
}

// ── 5. Guardar (solo plan_semanal) ────────────────────────────
$guardado = false;
if (!empty($body['guardar'])) {
    try {
        $st = $db->prepare('UPDATE cuestionarios_alimentacion SET plan_semanal = ?, fecha_actualizacion = NOW() WHERE usuario_id = ?');
        $st->execute([json_encode($plan, JSON_UNESCAPED_UNICODE), $uid]);
        $guardado = $st->rowCount() > 0;
    } catch (Throwable $e) {
        errorInterno('GenerarDieta', $e);
    }
}

salir(200, ['ok' => true, 'plan' => $plan, 'guardado' => $guardado, 'kcal_objetivo' => $kcalObjetivo]);
</file>

<file path="backend/Api/ia/GenerarRutina.php">
<?php
require_once __DIR__ . '/../../Seguridad/Cors.php';
require_once __DIR__ . '/../../Seguridad/Autenticacion.php';
require_once __DIR__ . '/../../ia/llm.php';

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    echo json_encode(['error' => 'Método no permitido.']);
    exit;
}

$userId = $GLOBALS['userId'];
$db     = getDB();

// ── 1. Perfil del usuario ────────────────────────────────────
$stmt = $db->prepare('
    SELECT ch.*, u.nombre, u.peso_kg, u.altura_cm, u.objetivo,
           u.nivel_entrenamiento, u.equipo_disponible
    FROM cuestionario_habitos ch
    JOIN usuario u ON u.id_usuario = ch.id_usuario
    WHERE ch.id_usuario = ?
    ORDER BY ch.fecha_respuesta DESC
    LIMIT 1
');
$stmt->execute([$userId]);
$datos = $stmt->fetch();

if (!$datos) {
    http_response_code(422);
    echo json_encode(['error' => 'El usuario no ha completado el cuestionario.']);
    exit;
}

if (!llmPermitido((int) $userId, 'rutina')) {
    http_response_code(429);
    echo json_encode(['error' => 'Espera un minuto antes de generar otra rutina.']);
    exit;
}

// ── 2. Calcular días reales ──────────────────────────────────
$diasMap = ['nunca' => 2, '1_2' => 2, '3_4' => 3, '5_mas' => 5];
$diasSemana = $diasMap[$datos['frecuencia_semana'] ?? ''] ?? 3;

// PAR-Q+ con algún "Sí": rutina de baja intensidad hasta que lo vea un profesional
$parqConsultar = ($datos['parq_resultado'] ?? '') === 'consultar';
if ($parqConsultar) $diasSemana = min($diasSemana, 3);

// ── 3. Obtener ejercicios según equipo y nivel ───────────────
$equipo = strtolower($datos['equipo_disponible'] ?? 'ninguno');
$nivel  = $parqConsultar ? 'principiante' : ($datos['nivel_recomendado'] ?? 'principiante');

$nivelesMap = [
    'principiante' => ['principiante'],
    'intermedio'   => ['principiante', 'intermedio'],
    'avanzado'     => ['principiante', 'intermedio', 'avanzado'],
];
$nivelesPermitidos = $nivelesMap[$nivel] ?? ['principiante'];
$ph = implode(',', array_fill(0, count($nivelesPermitidos), '?'));

if (str_contains($equipo, 'gimnasio_completo')) {
    $equipoSQL    = '1=1';
    $equipoParams = [];
} else {
    $piezas = array_filter(array_map('trim', explode(',', $equipo)));
    $likes  = array_map(fn($e) => 'LOWER(equipo_necesario) LIKE ?', $piezas);
    $likes[] = "equipo_necesario = 'ninguno'";
    $likes[] = "equipo_necesario IS NULL";
    $equipoSQL    = '(' . implode(' OR ', $likes) . ')';
    $equipoParams = array_map(fn($e) => "%$e%", $piezas);
}

$stmt = $db->prepare("
    SELECT id_ejercicio, nombre, grupo_muscular, nivel_dificultad, equipo_necesario
    FROM ejercicio
    WHERE nivel_dificultad IN ($ph) AND $equipoSQL
    ORDER BY grupo_muscular, RAND()
");
$stmt->execute(array_merge($nivelesPermitidos, $equipoParams));
$ejerciciosDisponibles = $stmt->fetchAll();

if (empty($ejerciciosDisponibles)) {
    http_response_code(422);
    echo json_encode(['error' => 'No hay ejercicios disponibles para este perfil.']);
    exit;
}

// ── 4. Distribuir ejercicios por día en PHP ──────────────────
// Agrupar por grupo muscular
$porGrupo = [];
foreach ($ejerciciosDisponibles as $ej) {
    $porGrupo[$ej['grupo_muscular']][] = $ej;
}

// Shuffle dentro de cada grupo para variedad
foreach ($porGrupo as &$lista) shuffle($lista);
unset($lista);

$grupos      = array_keys($porGrupo);
$ejerciciosPorDia = ($nivel === 'principiante') ? 5 : ($nivel === 'intermedio' ? 6 : 8);

// Configuración según objetivo
$objetivoConfig = [
    'fuerza'       => ['series' => 4, 'reps' => 8,  'grupos_prioritarios' => ['pecho','espalda','piernas','hombros','brazos']],
    'resistencia'  => ['series' => 3, 'reps' => 15, 'grupos_prioritarios' => ['cardio','piernas','core','pecho','espalda']],
    'perdida_peso' => ['series' => 3, 'reps' => 15, 'grupos_prioritarios' => ['cardio','piernas','core','pecho','espalda']],
    'volumen'      => ['series' => 4, 'reps' => 10, 'grupos_prioritarios' => ['pecho','espalda','piernas','brazos','hombros']],
    'flexibilidad' => ['series' => 3, 'reps' => 12, 'grupos_prioritarios' => ['core','piernas','espalda','hombros','pecho']],
];

// usuario.objetivo usa los nombres del cuestionario; rutina.objetivo usa otros
$objetivoUsuario = $datos['objetivo_ejercicio'] ?? $datos['objetivo'] ?? 'fuerza';
$objetivo     = [
    'fuerza'        => 'fuerza',
    'masa_muscular' => 'volumen',
    'perdida_grasa' => 'perdida_peso',
    'resistencia'   => 'resistencia',
    'volumen'       => 'volumen',
    'flexibilidad'  => 'flexibilidad',
][$objetivoUsuario] ?? 'fuerza';
$config       = $objetivoConfig[$objetivo] ?? $objetivoConfig['fuerza'];
if ($parqConsultar) {   // menos series y más repeticiones con poco peso
    $config['series'] = min($config['series'], 2);
    $config['reps']   = max($config['reps'], 12);
}
$seriesBase   = $config['series'];
$repsBase     = $config['reps'];
$gruposPrio   = $config['grupos_prioritarios'];

// Ordenar grupos por prioridad
usort($grupos, function($a, $b) use ($gruposPrio) {
    $posA = array_search($a, $gruposPrio);
    $posB = array_search($b, $gruposPrio);
    $posA = ($posA === false) ? 99 : $posA;
    $posB = ($posB === false) ? 99 : $posB;
    return $posA - $posB;
});

// Distribuir grupos entre días (rotación)
$gruposPorDia = array_fill(1, $diasSemana, []);
$gi = 0;
foreach ($grupos as $grupo) {
    $dia = ($gi % $diasSemana) + 1;
    $gruposPorDia[$dia][] = $grupo;
    $gi++;
}

// Asignar ejercicios a cada día
$ejerciciosFinales = [];
$usadosPorDia = array_fill(1, $diasSemana, []);

for ($dia = 1; $dia <= $diasSemana; $dia++) {
    $orden = 1;
    $ejEnDia = 0;
    $gruposDelDia = $gruposPorDia[$dia];

    // Primera pasada: grupos asignados a este día
    foreach ($gruposDelDia as $grupo) {
        if (!isset($porGrupo[$grupo])) continue;
        foreach ($porGrupo[$grupo] as $ej) {
            if ($ejEnDia >= $ejerciciosPorDia) break;
            if (in_array($ej['id_ejercicio'], $usadosPorDia[$dia])) continue;
            $ejerciciosFinales[] = [
                'id_ejercicio'    => $ej['id_ejercicio'],
                'dia_semana'      => $dia,
                'orden'           => $orden++,
                'series_objetivo' => $seriesBase,
                'reps_objetivo'   => $repsBase,
                'peso_sugerido'   => null,
            ];
            $usadosPorDia[$dia][] = $ej['id_ejercicio'];
            $ejEnDia++;
        }
    }

    // Segunda pasada: rellenar con ejercicios de otros grupos si faltan
    if ($ejEnDia < $ejerciciosPorDia) {
        foreach ($ejerciciosDisponibles as $ej) {
            if ($ejEnDia >= $ejerciciosPorDia) break;
            if (in_array($ej['id_ejercicio'], $usadosPorDia[$dia])) continue;
            $ejerciciosFinales[] = [
                'id_ejercicio'    => $ej['id_ejercicio'],
                'dia_semana'      => $dia,
                'orden'           => $orden++,
                'series_objetivo' => $seriesBase,
                'reps_objetivo'   => $repsBase,
                'peso_sugerido'   => null,
            ];
            $usadosPorDia[$dia][] = $ej['id_ejercicio'];
            $ejEnDia++;
        }
    }
}

// ── 5. Usar la IA (LM Studio) SOLO para nombre y descripción ─
$nombrerutina  = 'rutina Personalizada';
$descripcion   = 'rutina generada según tu perfil y objetivos.';

$promptSimple = "Eres un entrenador personal. El usuario tiene nivel {$nivel}, objetivo {$objetivo}, entrena {$diasSemana} días/semana. Da un nombre creativo en español (máx 60 caracteres) y una descripción motivadora de 1 oración (máx 120 caracteres).";

$r = llmChat([['role' => 'user', 'content' => $promptSimple]], [
    'temperature'   => 0.5,
    'max_tokens'    => 200,
    'timeout'       => 120,
    'nombre_schema' => 'rutina',
    'json_schema'   => [
        'type' => 'object', 'additionalProperties' => false,
        'required' => ['nombre', 'descripcion'],
        'properties' => ['nombre' => ['type' => 'string'], 'descripcion' => ['type' => 'string']],
    ],
]);

if ($r['ok']) {
    $iaData = $r['json'] ?? llmExtraerJSON($r['content']);
    if (is_string($iaData['nombre'] ?? null) && trim($iaData['nombre']) !== '') {
        $nombrerutina = mb_substr(trim(strip_tags($iaData['nombre'])), 0, 80);
    }
    if (is_string($iaData['descripcion'] ?? null) && trim($iaData['descripcion']) !== '') {
        $descripcion = mb_substr(trim(strip_tags($iaData['descripcion'])), 0, 500);
    }
} else {
    error_log('[IA rutina] LM Studio: ' . $r['error']);   // la rutina se crea igual con nombre por defecto
}

if ($parqConsultar) {
    $descripcion = 'Rutina de baja intensidad: consulta a un profesional de la salud antes de aumentarla (PAR-Q+).';
}

// Mapear objetivo
$objetivosValidos = ['fuerza', 'resistencia', 'perdida_peso', 'volumen', 'flexibilidad'];
$objetivoFinal = in_array($objetivo, $objetivosValidos) ? $objetivo : 'fuerza';

// ── 6. Guardar en BD ─────────────────────────────────────────
try {
    $db->beginTransaction();

    $db->prepare('
        INSERT INTO rutina (id_usuario, nombre, descripcion, objetivo, nivel, dias_semana, activa, generada_ia)
        VALUES (?, ?, ?, ?, ?, ?, 1, 1)
    ')->execute([$userId, $nombrerutina, $descripcion, $objetivoFinal, $nivel, $diasSemana]);

    $idrutina = (int) $db->lastInsertId();

    $stmtEj = $db->prepare('
        INSERT IGNORE INTO rutina_ejercicio
            (id_rutina, id_ejercicio, dia_semana, orden, series_objetivo, reps_objetivo, peso_sugerido)
        VALUES (?, ?, ?, ?, ?, ?, ?)
    ');

    foreach ($ejerciciosFinales as $ej) {
        $stmtEj->execute([
            $idrutina,
            (int)   $ej['id_ejercicio'],
            (int)   $ej['dia_semana'],
            (int)   $ej['orden'],
            (int)   $ej['series_objetivo'],
            (int)   $ej['reps_objetivo'],
            $ej['peso_sugerido'],
        ]);
    }

    $db->commit();

    // Devolver rutina completa
    $stmt = $db->prepare('
        SELECT re.id, re.id_ejercicio, re.dia_semana, re.orden,
               re.series_objetivo, re.reps_objetivo, re.peso_sugerido,
               e.nombre, e.grupo_muscular, e.nivel_dificultad, e.equipo_necesario
        FROM rutina_ejercicio re
        JOIN ejercicio e ON e.id_ejercicio = re.id_ejercicio
        WHERE re.id_rutina = ?
        ORDER BY re.dia_semana, re.orden
    ');
    $stmt->execute([$idrutina]);
    $ejerciciosGuardados = $stmt->fetchAll();

    echo json_encode([
        'ok'        => true,
        'id_rutina' => $idrutina,
        'rutina'    => [
            'id_rutina'   => $idrutina,
            'nombre'      => $nombrerutina,
            'descripcion' => $descripcion,
            'objetivo'    => $objetivoFinal,
            'nivel'       => $nivel,
            'dias_semana' => $diasSemana,
            'activa'      => true,
            'ejercicios'  => $ejerciciosGuardados,
        ],
    ]);

} catch (Exception $e) {
    $db->rollBack();
    http_response_code(500);
    error_log('[IA rutina] ' . $e->getMessage());
    echo json_encode(['error' => 'Error al guardar la rutina.']);
}
