              <ChevronRight style={{ width:14,height:14 }} />
            </button>
          )}

          <p className="sp-footnote">
            Actividad de tu comunidad · próximamente podrás seguir a otros usuarios
          </p>
        </div>
      )}
    </div>
  )
}
