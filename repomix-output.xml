+<?php
+// ============================================================
+//  utils/consentimiento.php — Consentimiento informado (M2)
+//  Cada aceptación queda como un registro en consentimiento_informado
+//  (con versión e IP). Si cambia el texto, se sube CONSENTIMIENTO_VERSION
+//  y todos tienen que volver a aceptar.
+// ============================================================
+
+const CONSENTIMIENTO_VERSION = '2.0';
+
+function consentimientoVigente(PDO $db, int $uid): bool {
+    $st = $db->prepare('SELECT acepto FROM consentimiento_informado WHERE id_usuario = ? AND version = ? ORDER BY id_consentimiento DESC LIMIT 1');
+    $st->execute([$uid, CONSENTIMIENTO_VERSION]);
+    return (int) $st->fetchColumn() === 1;
+}
+
+/** Corta con 403 si el usuario no ha aceptado la versión vigente. */
+function exigirConsentimiento(PDO $db, int $uid): void {
+    if (!consentimientoVigente($db, $uid)) {
+        salir(403, ['error' => 'Antes de contestar los cuestionarios tienes que aceptar el consentimiento informado.', 'requiere_consentimiento' => true]);
+    }
+}
diff --git a/utils/dieta.php b/utils/dieta.php
new file mode 100644
index 0000000..bd2f661
--- /dev/null
+++ b/utils/dieta.php
@@ -0,0 +1,108 @@
+<?php
+// ============================================================
+//  utils/dieta.php
+//  Validación del plan semanal de comidas y armado del prompt.
+//  Estructura esperada:
+//  { dias: [{ dia, comidas: [{ tiempo, descripcion, kcal }] }], calorias_dia, nota }
+// ============================================================
+
+const DIAS_SEMANA = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
+
+/** Mínimo de calorías diarias que la app acepta en un plan (no ofrece dietas muy restrictivas). */
+const KCAL_MINIMO_SEGURO = 1400;
+const KCAL_MAXIMO        = 4500;
+
+/** Esquema JSON para LM Studio (response_format json_schema). */
+function esquemaPlanDieta(): array {
+    return [
+        'type' => 'object',
+        'additionalProperties' => false,
+        'required' => ['dias', 'calorias_dia', 'nota'],
+        'properties' => [
+            'calorias_dia' => ['type' => 'integer'],
+            'nota'         => ['type' => 'string'],
+            'dias' => [
+                'type' => 'array', 'minItems' => 7, 'maxItems' => 7,
+                'items' => [
+                    'type' => 'object',
+                    'additionalProperties' => false,
+                    'required' => ['dia', 'comidas'],
+                    'properties' => [
+                        'dia' => ['type' => 'string', 'enum' => DIAS_SEMANA],
+                        'comidas' => [
+                            'type' => 'array', 'minItems' => 3, 'maxItems' => 5,
+                            'items' => [
+                                'type' => 'object',
+                                'additionalProperties' => false,
+                                'required' => ['tiempo', 'descripcion', 'kcal'],
+                                'properties' => [
+                                    'tiempo'      => ['type' => 'string'],
+                                    'descripcion' => ['type' => 'string'],
+                                    'kcal'        => ['type' => 'integer'],
+                                ],
+                            ],
+                        ],
+                    ],
+                ],
+            ],
+        ],
+    ];
+}
+
+/** Texto limpio y recortado (sin HTML). */
+function textoPlano($v, int $max): string {
+    $t = trim(strip_tags((string) $v));
+    $t = preg_replace('/\s+/u', ' ', $t);
+    return mb_substr($t, 0, $max);
+}
+
+/**
+ * Valida y normaliza un plan. Devuelve el plan limpio o lanza InvalidArgumentException
+ * con el motivo. Nunca confía en lo que mande el cliente o el modelo.
+ */
+function validarPlanDieta($plan): array {
+    if (!is_array($plan) || !isset($plan['dias']) || !is_array($plan['dias'])) {
+        throw new InvalidArgumentException('El plan no tiene la lista de días.');
+    }
+    $dias = [];
+    foreach (array_slice($plan['dias'], 0, 7) as $d) {
+        if (!is_array($d) || !isset($d['comidas']) || !is_array($d['comidas'])) continue;
+        $nombre = textoPlano($d['dia'] ?? '', 12);
+        // Acepta "Miercoles"/"miércoles": se normaliza al nombre oficial
+        foreach (DIAS_SEMANA as $oficial) {
+            if (mb_strtolower(strtr($nombre, 'áéí', 'aei')) === mb_strtolower(strtr($oficial, 'áéí', 'aei'))) { $nombre = $oficial; break; }
+        }
+        if (!in_array($nombre, DIAS_SEMANA, true)) continue;
+
+        $comidas = [];
+        foreach (array_slice($d['comidas'], 0, 6) as $c) {
+            if (!is_array($c)) continue;
+            $desc = textoPlano($c['descripcion'] ?? '', 160);
+            if ($desc === '') continue;
+            $kcal = (int) ($c['kcal'] ?? 0);
+            $comidas[] = [
+                'tiempo'      => textoPlano($c['tiempo'] ?? 'Comida', 30) ?: 'Comida',
+                'descripcion' => $desc,
+                'kcal'        => max(0, min(2000, $kcal)),
+            ];
+        }
+        if (count($comidas) >= 2) $dias[] = ['dia' => $nombre, 'comidas' => $comidas];
+    }
+    if (count($dias) < 7) {
+        throw new InvalidArgumentException('El plan debe traer los 7 días con al menos 2 comidas cada uno.');
+    }
+
+    $kcalDia = (int) ($plan['calorias_dia'] ?? 0);
+    if ($kcalDia <= 0) {   // si no viene, se estima con el promedio de los días
+        $kcalDia = (int) round(array_sum(array_map(fn($d) => array_sum(array_column($d['comidas'], 'kcal')), $dias)) / 7);
+    }
+    if ($kcalDia < KCAL_MINIMO_SEGURO || $kcalDia > KCAL_MAXIMO) {
+        throw new InvalidArgumentException("Calorías por día fuera de un rango seguro ($kcalDia kcal).");
+    }
+
+    return [
+        'dias'         => $dias,
+        'calorias_dia' => $kcalDia,
+        'nota'         => textoPlano($plan['nota'] ?? '', 300),
+    ];
+}
diff --git a/utils/instrumentos.php b/utils/instrumentos.php
new file mode 100644
index 0000000..132e0e8
--- /dev/null
+++ b/utils/instrumentos.php
@@ -0,0 +1,205 @@
+<?php
+// ============================================================
+//  utils/instrumentos.php
+//  Validación y calificación de los cuestionarios EN EL SERVIDOR.
+//
+//  Las opciones válidas y sus puntos se leen de
+//  Configuracion/instrumentos.json, que se genera desde el
+//  frontend (scripts/exportar-instrumentos.mjs), así PHP y JS
+//  usan exactamente las mismas preguntas.
+//
+//  Las reglas de calificación replican src/modulos/cuestionarios/
+//  instrumentos.js (PAR-Q+, IPAQ, AUDIT-C, PHQ-8, GAD-7, CDMX 2023).
+//  Si cambias una, cambia la otra (hay una prueba que las compara).
+// ============================================================
+
+/** Preguntas y opciones válidas por módulo. */
+function instrumentos(): array {
+    static $data = null;
+    if ($data === null) {
+        $raw  = file_get_contents(__DIR__ . '/../Configuracion/instrumentos.json');
+        $data = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
+    }
+    return $data;
+}
+
+/**
+ * Preguntas que solo aparecen según otra respuesta: id => [pregunta_de_la_que_depende, valor_que_la_oculta].
+ * Debe coincidir con los showIf de instrumentos.js.
+ */
+const PREGUNTAS_CONDICIONALES = [
+    'ipaq_vig_min'    => ['ipaq_vig_dias', '0'],
+    'ipaq_mod_min'    => ['ipaq_mod_dias', '0'],
+    'ipaq_cam_min'    => ['ipaq_cam_dias', '0'],
+    'audit_cantidad'  => ['audit_frecuencia', 'nunca'],
+    'audit_atracon'   => ['audit_frecuencia', 'nunca'],
+    'refrescos_vasos' => ['refrescos_dias', 'ninguno'],
+];
+
+function preguntaAplica(string $id, array $a): bool {
+    if (!isset(PREGUNTAS_CONDICIONALES[$id])) return true;
+    [$padre, $oculta] = PREGUNTAS_CONDICIONALES[$id];
+    return isset($a[$padre]) && $a[$padre] !== '' && (string) $a[$padre] !== $oculta;
+}
+
+/**
+ * Toma el body crudo y devuelve solo las respuestas válidas del módulo:
+ *  - campos desconocidos: se ignoran
+ *  - pregunta que no aplica o sin contestar: null
+ *  - valor que no está entre las opciones: lanza InvalidArgumentException (422)
+ */
+function limpiarRespuestas(string $modulo, array $body): array {
+    $preguntas = instrumentos()[$modulo] ?? throw new InvalidArgumentException("Módulo desconocido: $modulo");
+    $limpias = [];
+
+    // Primero los valores crudos válidos (necesarios para saber qué aplica)
+    foreach ($preguntas as $id => $p) {
+        $v = $body[$id] ?? null;
+        if ($v === null || $v === '') { $limpias[$id] = null; continue; }
+        $v = (string) $v;
+        if (!array_key_exists($v, $p['opciones'])) {
+            throw new InvalidArgumentException("Respuesta no válida en '$id'.");
+        }
+        $limpias[$id] = $v;
+    }
+    // Luego se anulan las que no aplican
+    foreach ($limpias as $id => $v) {
+        if (!preguntaAplica($id, $limpias)) $limpias[$id] = null;
+    }
+    return $limpias;
+}
+
+/** Puntos (pts) o valor (v) de la opción elegida. */
+function opcionDato(string $modulo, string $id, array $a, string $campo = 'pts', $def = 0) {
+    $v = $a[$id] ?? null;
+    if ($v === null) return $def;
+    return instrumentos()[$modulo][$id]['opciones'][$v][$campo] ?? $def;
+}
+
+// ─────────────────────────── EJERCICIO (PAR-Q+ + IPAQ) ───────────────────────────
+
+function evaluarEjercicio(array $a): array {
+    $dias = fn(string $id) => (int) opcionDato('ejercicio', $id, $a, 'v', 0);
+    $mins = fn(string $diasId, string $minId) => $dias($diasId) > 0 ? (int) opcionDato('ejercicio', $minId, $a, 'v', 0) : 0;
+
+    $vigD = $dias('ipaq_vig_dias'); $vigM = $mins('ipaq_vig_dias', 'ipaq_vig_min');
+    $modD = $dias('ipaq_mod_dias'); $modM = $mins('ipaq_mod_dias', 'ipaq_mod_min');
+    $camD = $dias('ipaq_cam_dias'); $camM = $mins('ipaq_cam_dias', 'ipaq_cam_min');
+
+    $metVig = 8.0 * $vigM * $vigD;
+    $metMod = 4.0 * $modM * $modD;
+    $metCam = 3.3 * $camM * $camD;
+    $met    = (int) round($metVig + $metMod + $metCam);
+    $diasTotales = min(7, $vigD + $modD + $camD);
+
+    $categoria = 'bajo';
+    if (($vigD >= 3 && $metVig >= 1500) || ($diasTotales >= 7 && $met >= 3000)) {
+        $categoria = 'alto';
+    } elseif (
+        ($vigD >= 3 && $vigM >= 20) ||
+        ((($modM >= 30) ? $modD : 0) + (($camM >= 30) ? $camD : 0)) >= 5 ||
+        ($diasTotales >= 5 && $met >= 600)
+    ) {
+        $categoria = 'moderado';
+    }
+
+    $parqSi = [];
+    foreach (array_keys(instrumentos()['ejercicio']) as $id) {
+        if (str_starts_with($id, 'parq_') && ($a[$id] ?? null) === 'si') $parqSi[] = $id;
+    }
+
+    $nivel = ['bajo' => 'principiante', 'moderado' => 'intermedio', 'alto' => 'avanzado'][$categoria];
+    if ($parqSi) $nivel = 'principiante';
+
+    return [
+        'met'            => $met,
+        'categoria'      => $categoria,
+        'score'          => min(100, (int) round($met / 30)),
+        'nivel'          => $nivel,
+        'parq_si'        => $parqSi,
+        'parq_resultado' => $parqSi ? 'consultar' : 'apto',
+        'minutos_semana' => $vigM * $vigD + $modM * $modD + $camM * $camD,
+        'dias_max'       => max($vigD, $modD),
+    ];
+}
+
+// ─────────────────────────── CLÍNICO (OMS STEPS, AUDIT-C, FINDRISC) ───────────────────────────
+
+/** AUDIT-C: 4+ hombres, 3+ mujeres o sin dato; en menores de 18 cualquier consumo. */
+function corteAuditC(?string $sexo, ?int $edad): int {
+    if ($edad !== null && $edad < 18) return 1;
+    return $sexo === 'masculino' ? 4 : 3;
+}
+
+function evaluarClinico(array $a, ?string $sexo = null, ?int $edad = null): array {
+    $p = fn(string $id) => (int) opcionDato('clinico', $id, $a);
+    $toma = ($a['audit_frecuencia'] ?? null) !== null && $a['audit_frecuencia'] !== 'nunca';
+
+    $auditC   = $toma ? $p('audit_frecuencia') + $p('audit_cantidad') + $p('audit_atracon') : 0;
+    $corte    = corteAuditC($sexo, $edad);
+    $positivo = $auditC >= $corte;
+    $ptsAlc   = $auditC === 0 ? 15 : ($positivo ? 0 : 8);
+
+    $score = min(100,
+        $p('srh_salud') + $p('tabaco_actual') + $p('vapeo_actual') + $ptsAlc +
+        $p('presion_dx') + $p('glucosa_dx') + $p('colesterol_dx') + $p('sueno_horas') + $p('vacunas')
+    );
+    $nivel = $score < 40 ? 'critico' : ($score < 60 ? 'moderado' : ($score < 80 ? 'bueno' : 'optimo'));
+
+    return [
+        'score'          => $score,
+        'nivel'          => $nivel,
+        'audit_c'        => $auditC,
+        'audit_positivo' => $positivo,
+        'findrisc'       => (int) opcionDato('clinico', 'antecedente_diabetes', $a, 'findrisc', 0),
+    ];
+}
+
+// ─────────────────────────── PSICOLOGÍA (PHQ-8 + GAD-7) ───────────────────────────
+
+function evaluarPsicologia(array $a): array {
+    $phq8 = 0; $gad7 = 0;
+    foreach (array_keys(instrumentos()['psicologia']) as $id) {
+        if (str_starts_with($id, 'phq_')) $phq8 += (int) opcionDato('psicologia', $id, $a);
+        if (str_starts_with($id, 'gad_')) $gad7 += (int) opcionDato('psicologia', $id, $a);
+    }
+    $peor  = max($phq8, $gad7);
+    $score = (int) round(100 - (($phq8 + $gad7) / 45) * 100);
+    $nivel = $peor >= 15 ? 'critico' : ($peor >= 10 ? 'vulnerable' : ($peor >= 5 ? 'moderado' : 'resiliente'));
+
+    return ['phq8' => $phq8, 'gad7' => $gad7, 'score' => $score, 'nivel' => $nivel];
+}
+
+// ─────────────────────────── ALIMENTACIÓN (CDMX 2023) ───────────────────────────
+
+function evaluarAlimentacion(array $a): array {
+    $puntos = 0; $max = 0;
+    foreach (instrumentos()['alimentacion'] as $id => $p) {
+        $califica = false;
+        foreach ($p['opciones'] as $o) { if (isset($o['pts'])) { $califica = true; break; } }
+        if (!$califica) continue;
+        $max += 3;
+        if ($id === 'refrescos_vasos' && !preguntaAplica($id, $a)) { $puntos += 3; continue; }
+        $puntos += (int) opcionDato('alimentacion', $id, $a);
+    }
+    $pct   = $max ? $puntos / $max : 0;
+    $nivel = $pct < 0.5 ? 'deficiente' : ($pct < 0.75 ? 'mejorable' : ($pct < 0.9 ? 'adecuado' : 'optimo'));
+    return ['puntos' => $puntos, 'max' => $max, 'score' => (int) round($pct * 100), 'nivel' => $nivel];
+}
+
+// ─────────────────────────── utilidades ───────────────────────────
+
+/** Edad en años a partir de una fecha AAAA-MM-DD (null si no hay). */
+function edadDesde(?string $fecha): ?int {
+    if (!$fecha) return null;
+    try { return (new DateTime($fecha))->diff(new DateTime('today'))->y; }
+    catch (Exception) { return null; }
+}
+
+/** Fila mínima del usuario para calificar (sexo y edad). */
+function datosBaseUsuario(PDO $db, int $uid): array {
+    $st = $db->prepare('SELECT sexo_biologico, fecha_nacimiento FROM usuario WHERE id_usuario = ?');
+    $st->execute([$uid]);
+    $u = $st->fetch() ?: [];
+    return ['sexo' => $u['sexo_biologico'] ?? null, 'edad' => edadDesde($u['fecha_nacimiento'] ?? null)];
+}
</file>

<file path="docker-compose.yml">
# LIFE FIT con Docker: base de datos + backend PHP + frontend, con un solo comando.
#   1. Pon el respaldo de tu base en docker/db/00_fitness.sql (en UTF-8).
#   2. docker compose up --build
#   3. Abre http://localhost:5173
# LM Studio sigue corriendo en tu compu (fuera de Docker), en el puerto 1234.

services:
  db:
    image: mariadb:10.11
    environment:
      MARIADB_DATABASE: fitness
      MARIADB_USER: lifefit
      MARIADB_PASSWORD: lifefit
      MARIADB_ROOT_PASSWORD: root
    volumes:
      - db_data:/var/lib/mysql
      # Solo corren la primera vez (con la base vacía), en orden alfabético
      - ./docker/db/00_fitness.sql:/docker-entrypoint-initdb.d/00_fitness.sql:ro
      - ./backend/migraciones/001_cuestionarios_validados.sql:/docker-entrypoint-initdb.d/10_001.sql:ro
      - ./backend/migraciones/002_seguimiento_animo.sql:/docker-entrypoint-initdb.d/11_002.sql:ro
      - ./backend/migraciones/003_login_intentos.sql:/docker-entrypoint-initdb.d/12_003.sql:ro
      - ./backend/migraciones/004_privacidad_ranking.sql:/docker-entrypoint-initdb.d/13_004.sql:ro
    ports:
      - "3308:3306"   # para entrar con phpMyAdmin/Workbench desde tu compu
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 5s
      retries: 20

  backend:
    build:
      context: .
      dockerfile: docker/backend.Dockerfile
    environment:
      DB_HOST: db
      DB_PORT: "3306"
      DB_NAME: fitness
      DB_USER: lifefit
      DB_PASS: lifefit
      JWT_SECRET: cambia-esto-por-una-cadena-larga-y-aleatoria-de-32-o-mas
      LLM_URL: http://host.docker.internal:1234/v1
      LLM_MODEL: qwen/qwen3-4b-2507
    extra_hosts:
      - "host.docker.internal:host-gateway"   # para llegar a LM Studio en tu compu (Linux)
    volumes:
      - ./backend:/var/www/html/backend
      - ./docker/local.php:/var/www/html/backend/Configuracion/local.php:ro
    depends_on:
      db:
        condition: service_healthy

  frontend:
    image: node:22-alpine
    working_dir: /app
    command: sh -c "npm install && npm run dev -- --host 0.0.0.0 --port 5173"
    environment:
      BACKEND_URL: http://backend
    volumes:
      - ./frontend:/app
      - frontend_modules:/app/node_modules
    ports:
      - "5173:5173"
    depends_on:
      - backend

volumes:
  db_data:
  frontend_modules:
</file>

<file path="iniciar.bat">
@echo off
chcp 65001 >nul
REM ============================================================
REM  LIFE FIT - levanta todo con doble clic (Windows + XAMPP)
REM  1. Revisa que Apache/MySQL de XAMPP y LM Studio respondan
REM  2. Instala dependencias del frontend (solo la primera vez)
REM  3. Abre el navegador y arranca la app
REM ============================================================
cd /d "%~dp0"

echo.
echo  == LIFE FIT ==
echo.

curl -s -o nul -w "%%{http_code}" http://localhost/backend/Api/Auth/Consentimiento.php > "%TEMP%\lifefit_back.txt" 2>nul
set /p BACK=<"%TEMP%\lifefit_back.txt"
if "%BACK%"=="401" (
  echo  [OK]  Backend PHP en http://localhost/backend
) else (
  echo  [!!]  No responde el backend en http://localhost/backend/Api
  echo        Abre XAMPP, prende Apache y MySQL, y revisa que la carpeta se llame "backend" dentro de htdocs.
)

curl -s -o nul -w "%%{http_code}" http://localhost:1234/v1/models > "%TEMP%\lifefit_llm.txt" 2>nul
set /p LLM=<"%TEMP%\lifefit_llm.txt"
if "%LLM%"=="200" (
  echo  [OK]  LM Studio en el puerto 1234
) else (
  echo  [!!]  LM Studio no responde: la app funciona, pero sin IA. En LM Studio: Developer ^> Start Server.
)
echo.

cd frontend
if not exist node_modules (
