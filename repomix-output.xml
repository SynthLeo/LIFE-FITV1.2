import { Card, CardHeader, CardTitle, CardContent, Button, Badge, Input, Label, Spinner, EmptyState } from '@/presentacion/componentes/ui'
import {
  Dumbbell, Play, Square, Plus, Check, ChevronDown, ChevronUp,
