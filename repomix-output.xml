+        exigirMetodo('GET');
+    }
+    $st = $db->prepare('SELECT ocultar_ranking FROM usuario WHERE id_usuario = ?');
+    $st->execute([$uid]);
+    salir(200, ['ok' => true, 'ocultar_ranking' => (bool) $st->fetchColumn()]);
+} catch (Throwable $e) {
+    errorInterno('Social/Privacidad', $e);
+}
