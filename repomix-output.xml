          className="text-[10px] px-3 py-1.5 rounded-lg border transition-all flex-shrink-0"
          style={{ borderColor: 'rgba(22,163,74,0.3)', color: COLOR, background: 'rgba(22,163,74,0.06)' }}
        >
          ✏️ Perfil
        </button>
        <button
          onClick={regenerarPlan}
          disabled={generando}
          className="text-[10px] px-3 py-1.5 rounded-lg border transition-all flex-shrink-0 disabled:opacity-50"
          style={{ borderColor: 'rgba(22,163,74,0.3)', color: COLOR, background: 'rgba(22,163,74,0.06)' }}
        >
          {generando ? 'Generando…' : '🔄 Nuevo plan'}
        </button>
        <button
          onClick={() => descargarDietaPDF(plan).catch(e => setErrorPlan(e.message))}
          className="text-[10px] px-3 py-1.5 rounded-lg border transition-all flex-shrink-0"
          style={{ borderColor: 'rgba(22,163,74,0.3)', color: COLOR, background: 'rgba(22,163,74,0.06)' }}
        >
          ⬇️ PDF
        </button>
        <button
          onClick={() => { try { descargarDietaCSV(plan) } catch (e) { setErrorPlan(e.message) } }}
          className="text-[10px] px-3 py-1.5 rounded-lg border transition-all flex-shrink-0"
          style={{ borderColor: 'rgba(22,163,74,0.3)', color: COLOR, background: 'rgba(22,163,74,0.06)' }}
