<file path="backend/Api/Cuestionario/Seguimiento.php">
<?php
// ============================================================
//  Api/Cuestionario/Seguimiento.php — PHQ-8 + GAD-7 cada 2 semanas (M3)
//  GET  → { mediciones:[{fecha, phq8, gad7}], toca, dias_para_siguiente }
//         (la primera medición es la del onboarding)
//  POST { respuestas: { phq_interes: 0-3, …, gad_miedo: 0-3 } }
//       → guarda una medición NUEVA y dice si empeoró.
//  Datos sensibles: solo los ve el propio usuario.
// ============================================================

require_once __DIR__ . '/../../Seguridad/Cors.php';
require_once __DIR__ . '/../../Seguridad/Autenticacion.php';
require_once __DIR__ . '/../../utils/api.php';
require_once __DIR__ . '/../../utils/consentimiento.php';

const SEG_PHQ  = ['phq_interes', 'phq_animo', 'phq_sueno', 'phq_energia', 'phq_apetito', 'phq_autoestima', 'phq_concentracion', 'phq_movimiento'];
const SEG_GAD  = ['gad_nervios', 'gad_control', 'gad_preocupacion', 'gad_relajarse', 'gad_inquietud', 'gad_irritable', 'gad_miedo'];
const SEG_DIAS = 14;
const SEG_CAMBIO_IMPORTANTE = 5;   // 5 puntos = cambio clínicamente relevante en PHQ/GAD

$uid = (int) $GLOBALS['userId'];

function medicionesDe(PDO $db, int $uid): array {
    $base = $db->prepare('SELECT fecha_registro AS fecha, phq8_total AS phq8, gad7_total AS gad7
                          FROM cuestionarios_psicologicos WHERE usuario_id = ? AND phq8_total IS NOT NULL');
    $base->execute([$uid]);
    $seg = $db->prepare('SELECT created_at AS fecha, phq8_total AS phq8, gad7_total AS gad7
                         FROM seguimiento_animo WHERE id_usuario = ? ORDER BY created_at');
    $seg->execute([$uid]);
    $todas = array_merge($base->fetchAll(), $seg->fetchAll());
    return array_map(fn($m) => ['fecha' => $m['fecha'], 'phq8' => (int) $m['phq8'], 'gad7' => (int) $m['gad7']], $todas);
}

function estadoSeguimiento(array $mediciones): array {
    if (!$mediciones) return ['toca' => false, 'dias_para_siguiente' => null];
    $ultima = new DateTime(end($mediciones)['fecha']);
    $dias   = (int) $ultima->diff(new DateTime())->days;
    return ['toca' => $dias >= SEG_DIAS, 'dias_para_siguiente' => max(0, SEG_DIAS - $dias)];
}

try {
    $db = getDB();

    if ($_SERVER['REQUEST_METHOD'] === 'GET') {
        $m = medicionesDe($db, $uid);
        salir(200, ['ok' => true, 'mediciones' => $m] + estadoSeguimiento($m));
    }

    exigirMetodo('POST');
    exigirConsentimiento($db, $uid);

    $r = jsonBody()['respuestas'] ?? null;
    if (!is_array($r)) salir(422, ['error' => 'Faltan las respuestas.']);
    $limpias = [];
    foreach (array_merge(SEG_PHQ, SEG_GAD) as $id) {
        $v = $r[$id] ?? null;
        if (!is_numeric($v) || (int) $v != $v || $v < 0 || $v > 3) salir(422, ['error' => "Respuesta inválida o faltante: $id."]);
        $limpias[$id] = (int) $v;
    }
    $phq8 = array_sum(array_intersect_key($limpias, array_flip(SEG_PHQ)));
    $gad7 = array_sum(array_intersect_key($limpias, array_flip(SEG_GAD)));

    $antes = medicionesDe($db, $uid);
    if (!estadoSeguimiento($antes)['toca'] && $antes) {
        salir(429, ['error' => 'Todavía no toca. El seguimiento es cada 2 semanas.'] + estadoSeguimiento($antes));
    }

    $db->prepare('INSERT INTO seguimiento_animo (id_usuario, phq8_total, gad7_total, respuestas) VALUES (?, ?, ?, ?)')
       ->execute([$uid, $phq8, $gad7, json_encode($limpias)]);
} catch (Throwable $e) {
    errorInterno('Seguimiento', $e);
}

$previa  = $antes ? end($antes) : null;
$empeoro = $previa && ($phq8 - $previa['phq8'] >= SEG_CAMBIO_IMPORTANTE || $gad7 - $previa['gad7'] >= SEG_CAMBIO_IMPORTANTE);
$peor    = max($phq8, $gad7);

salir(200, [
    'ok'               => true,
    'phq8'             => $phq8,
    'gad7'             => $gad7,
    'empeoro'          => $empeoro,
    'sugerir_consulta' => $empeoro || $peor >= 10,
    'mostrar_linea'    => $peor >= 15,
]);
</file>

<file path="backend/Api/Entrenamiento/FinalizarSesion.php">
<?php
require_once __DIR__ . '/../../Seguridad/Cors.php';
require_once __DIR__ . '/../../Seguridad/Autenticacion.php';

if ($_SERVER['REQUEST_METHOD'] !== 'PUT') {
    http_response_code(405);
    echo json_encode(['error' => 'Método no permitido.']);
    exit;
}

$userId = $GLOBALS['userId'];
$db     = getDB();

$body      = json_decode(file_get_contents('php://input'), true) ?? [];
$idSesion  = (int) ($body['id_sesion']        ?? 0);
$duracion  = (int) ($body['duracion_minutos'] ?? 0);
$sensacion = trim($body['sensacion']          ?? '');
$notas     = trim($body['notas']              ?? '');

if (!$idSesion) {
    http_response_code(422);
    echo json_encode(['error' => 'id_sesion requerido.']);
    exit;
}

$sensacionesValidas = ['muy_mal', 'mal', 'regular', 'bien', 'muy_bien', ''];
if (!in_array($sensacion, $sensacionesValidas, true)) $sensacion = '';

try {
    // Verificar sesión del usuario
    $stmt = $db->prepare('SELECT id_sesion, volumen_total_kg FROM sesion WHERE id_sesion = ? AND id_usuario = ?');
    $stmt->execute([$idSesion, $userId]);
    $sesion = $stmt->fetch();

    if (!$sesion) {
        http_response_code(404);
        echo json_encode(['error' => 'Sesión no encontrada.']);
        exit;
    }

    // Recalcular volumen real desde los registros (más preciso)
    $stmt = $db->prepare('
        SELECT COALESCE(SUM(volumen_total_kg), 0) as volumen_real,
               COUNT(*) as total_series
        FROM registro_entrenamiento
        WHERE id_sesion = ? AND id_usuario = ?
    ');
    $stmt->execute([$idSesion, $userId]);
    $stats = $stmt->fetch();

    $volumenReal  = (float) $stats['volumen_real'];
    $totalSeries  = (int)   $stats['total_series'];

    // Finalizar sesión
    $stmt = $db->prepare('
        UPDATE sesion SET
            duracion_minutos  = ?,
            sensacion         = ?,
            notas             = ?,
            volumen_total_kg  = ?
        WHERE id_sesion = ? AND id_usuario = ?
    ');
    $stmt->execute([
        $duracion > 0 ? $duracion : null,
        $sensacion ?: null,
        $notas ?: null,
        $volumenReal,
        $idSesion,
        $userId,
    ]);

    // Actualizar progreso_usuario del día
    $stmt = $db->prepare('
        INSERT INTO progreso_usuario (id_usuario, fecha, volumen_total_kg, sesiones_completadas)
        VALUES (?, CURDATE(), ?, 1)
        ON DUPLICATE KEY UPDATE
            volumen_total_kg      = volumen_total_kg + VALUES(volumen_total_kg),
            sesiones_completadas  = sesiones_completadas + 1
    ');
    $stmt->execute([$userId, $volumenReal]);

    echo json_encode([
        'ok'           => true,
        'id_sesion'    => $idSesion,
        'duracion'     => $duracion,
        'volumen'      => $volumenReal,
        'total_series' => $totalSeries,
    ]);

} catch (Exception $e) {
    http_response_code(500);
    error_log('[FinalizarSesion] ' . $e->getMessage());
    echo json_encode(['error' => 'Error interno del servidor.']);
}
</file>

<file path="backend/Api/Entrenamiento/IniciarSesion.php">
<?php
require_once __DIR__ . '/../../Seguridad/Cors.php';
require_once __DIR__ . '/../../Seguridad/Autenticacion.php';

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    echo json_encode(['error' => 'Método no permitido.']);
    exit;
}

$userId = $GLOBALS['userId'];
$db     = getDB();

$body     = json_decode(file_get_contents('php://input'), true) ?? [];
$idrutina = isset($body['id_rutina']) ? (int) $body['id_rutina'] : null;

try {
    // Si viene con rutina, verificar que pertenece al usuario
    if ($idrutina) {
        $stmt = $db->prepare('SELECT id_rutina, nombre FROM rutina WHERE id_rutina = ? AND id_usuario = ?');
        $stmt->execute([$idrutina, $userId]);
        $rutina = $stmt->fetch();
        if (!$rutina) {
            http_response_code(404);
            echo json_encode(['error' => 'rutina no encontrada.']);
            exit;
        }
    }

    // Crear sesión
    $stmt = $db->prepare('
        INSERT INTO sesion (id_usuario, id_rutina, fecha)
        VALUES (?, ?, CURDATE())
    ');
    $stmt->execute([$userId, $idrutina]);
    $idSesion = (int) $db->lastInsertId();

    // Si tiene rutina, traer ejercicios del día
    $ejercicios = [];
    if ($idrutina) {
        // Determinar qué día de la semana es (1=Lunes ... 7=Domingo)
        $diaSemana = (int) date('N');

        $stmt = $db->prepare('
            SELECT re.id, re.id_ejercicio, re.dia_semana, re.orden,
                   re.series_objetivo, re.reps_objetivo, re.peso_sugerido,
                   e.nombre, e.grupo_muscular, e.nivel_dificultad, e.equipo_necesario, e.imagen_url
            FROM rutina_ejercicio re
            JOIN ejercicio e ON e.id_ejercicio = re.id_ejercicio
            WHERE re.id_rutina = ?
            ORDER BY re.dia_semana, re.orden
        ');
        $stmt->execute([$idrutina]);
        $todos = $stmt->fetchAll();

        // Intentar filtrar por día actual, si no hay usar todos
        $delDia = array_filter($todos, fn($e) => $e['dia_semana'] === $diaSemana);
        $ejercicios = !empty($delDia) ? array_values($delDia) : $todos;
    }

    echo json_encode([
        'ok'         => true,
        'id_sesion'  => $idSesion,
        'ejercicios' => $ejercicios,
        'rutina'     => $rutina ?? null,
    ]);

} catch (Exception $e) {
    http_response_code(500);
    error_log('[IniciarSesion] ' . $e->getMessage());
    echo json_encode(['error' => 'Error interno del servidor.']);
}
