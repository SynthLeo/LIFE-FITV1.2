                    </span>
                    <span className="text-xs text-muted-foreground flex-1 leading-relaxed">{c.descripcion}</span>
                    {c.kcal && (
                      <span className="text-[10px] font-mono text-muted-foreground whitespace-nowrap pt-0.5">
                        ~{c.kcal} kcal
                      </span>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        )
      })}
    </div>
  )
}

