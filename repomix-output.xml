<file path="backend/ia/chat.php">
<?php
// ============================================================
//  POST ia/chat.php — chat con la IA (LM Studio)
//  Body: { modulo: ejercicio|psicologia|alimentacion|clinico, mensaje, stream? }
//  Con stream: true responde NDJSON: {"delta":"..."} … {"fin":true,"es_crisis":bool} o {"error":"..."}
//  Auth: Bearer JWT (verificado). El id_usuario del body se ignora.
//
//  Orden:
//   1. Autenticación y límite de peticiones
//   2. Detección de crisis en el servidor → mensaje fijo, SIN llamar al modelo
//   3. Prompt del módulo + perfil resumido + historial
//   4. LM Studio
//   5. Guardar en ia_conversacion
// ============================================================

require_once __DIR__ . '/../config/headers.php';
require_once __DIR__ . '/../config/database.php';
require_once __DIR__ . '/../Seguridad/Sesion.php';
require_once __DIR__ . '/prompts.php';
require_once __DIR__ . '/memoria.php';
require_once __DIR__ . '/llm.php';
require_once __DIR__ . '/crisis.php';
require_once __DIR__ . '/perfil.php';

metodo('POST');

/** Respuesta en pedazos: una línea JSON por pedazo (NDJSON), sin búfer. */
function iniciarStream(): void {
    header('Content-Type: application/x-ndjson; charset=utf-8');
    header('Cache-Control: no-cache');
    header('X-Accel-Buffering: no');   // nginx/proxies: no acumular
    @ini_set('zlib.output_compression', '0');
    @ini_set('output_buffering', '0');
    while (ob_get_level() > 0) ob_end_flush();
}
function enviarLinea(array $datos): void {
    echo json_encode($datos, JSON_UNESCAPED_UNICODE) . "\n";
    @ob_flush();
    flush();
}
$idusuario = usuarioAutenticadoId();

$body    = body();
$stream  = !empty($body['stream']);   // true → la respuesta llega en pedazos (NDJSON)
$modulo  = $body['modulo'] ?? '';
$mensaje = trim((string) ($body['mensaje'] ?? ''));

$modulosValidos = ['ejercicio', 'psicologia', 'alimentacion', 'clinico'];
if (!in_array($modulo, $modulosValidos, true)) error('Módulo no válido.');
if ($mensaje === '')            error('El mensaje no puede estar vacío.');
if (mb_strlen($mensaje) > 2000) error('El mensaje es demasiado largo (máximo 2000 caracteres).');

$perfil = cargarPerfilIA($idusuario);
if (!$perfil) error('Usuario no encontrado.', 404);

// ── 1. Crisis: respuesta fija, sin modelo ─────────────────────
$tipoCrisis = detectarCrisis($mensaje);
if ($tipoCrisis !== null) {
    $respuesta = mensajeCrisis($tipoCrisis);
    guardarMensaje($idusuario, $modulo, 'user',      $mensaje,   true);
    guardarMensaje($idusuario, $modulo, 'assistant', $respuesta, true);
    if ($stream) {
        iniciarStream();
        enviarLinea(['delta' => $respuesta]);
        enviarLinea(['fin' => true, 'es_crisis' => true, 'tipo_crisis' => $tipoCrisis]);
        exit;
    }
    respuesta([
        'respuesta'   => $respuesta,
        'es_crisis'   => true,
        'tipo_crisis' => $tipoCrisis,
        'tokens'      => 0,
    ]);
}

// ── 2. Límite de peticiones (la GPU de la laptop es una sola) ──
if (!llmPermitido($idusuario, 'chat')) {
    error('Vas muy rápido 😅 Espera un minuto y vuelve a intentarlo.', 429);
}

// ── 3. Construir mensajes ─────────────────────────────────────
$resumen         = getResumenHistorial($idusuario, $modulo);
$systemPrompt    = getSystemPrompt($modulo, $perfil, $resumen, cargarCuestionariosIA($idusuario));
$historialSesion = getHistorialSesion($idusuario, $modulo);

$messages = [['role' => 'system', 'content' => $systemPrompt]];
foreach ($historialSesion as $h) {
    $messages[] = ['role' => $h['rol'], 'content' => $h['contenido']];
}

// Refuerzo determinista: si proponen una dieta muy baja en calorías, se le recuerda al modelo no validarla
$mensajeModelo = $mensaje;
if (preg_match('/(\d{3,4})\s*(k?cal|calor[ií]as)/iu', $mensaje, $m) && (int) $m[1] < 1400) {
    $mensajeModelo .= "\n\n[Nota del sistema: el usuario propone {$m[1]} kcal al día, por debajo del mínimo seguro. No lo valides; explica el riesgo con empatía y sugiere un nutriólogo.]";
}
$messages[] = ['role' => 'user', 'content' => $mensajeModelo];

// ── 4. LM Studio ──────────────────────────────────────────────
if ($stream) {
    iniciarStream();
    $r = llmChatStream($messages, fn(string $t) => enviarLinea(['delta' => $t]), [
        'temperature' => 0.6,
        'top_p'       => 0.9,
        'max_tokens'  => 700,
        'timeout'     => 180,
    ]);
    if (!$r['ok']) {
        error_log('[ia/chat stream] ' . $r['error']);
        enviarLinea(['error' => 'El asistente no está disponible en este momento. Revisa que LM Studio esté corriendo.']);
        exit;
    }
    guardarMensaje($idusuario, $modulo, 'user',      $mensaje,       false);
    guardarMensaje($idusuario, $modulo, 'assistant', $r['content'],  false);
    enviarLinea(['fin' => true, 'es_crisis' => false]);
    exit;
}

$r = llmChat($messages, [
    'temperature' => 0.6,
    'top_p'       => 0.9,
    'max_tokens'  => 700,
    'timeout'     => 180,
]);
if (!$r['ok']) {
    error_log('[ia/chat] ' . $r['error']);
    error('El asistente no está disponible en este momento. Revisa que LM Studio esté corriendo.', 503);
}
$respuesta = $r['content'];

// ── 5. Guardar y responder ────────────────────────────────────
guardarMensaje($idusuario, $modulo, 'user',      $mensaje,   false);
guardarMensaje($idusuario, $modulo, 'assistant', $respuesta, false);

respuesta([
    'respuesta' => $respuesta,
    'es_crisis' => false,
    'tokens'    => $r['tokens'],
]);
</file>

<file path="backend/ia/crisis.php">
<?php
// ============================================================
//  ia/crisis.php
//  Detección de crisis EN EL SERVIDOR, antes de llamar al modelo.
//  Si se detecta, el chat responde con un mensaje fijo revisado
//  y NO pregunta al modelo (no dependemos de que el modelo
//  "se porte bien").
//
//  Es una lista de palabras clave: puede dar falsos positivos.
//  En salud mental es preferible pecar de cuidadoso.
// ============================================================

require_once __DIR__ . '/../Configuracion/Conexion.php';

/** Minúsculas y sin acentos, para comparar sin importar cómo escriban. */
function normalizarTexto(string $t): string {
    $t = mb_strtolower($t, 'UTF-8');
    $t = strtr($t, ['á' => 'a', 'é' => 'e', 'í' => 'i', 'ó' => 'o', 'ú' => 'u', 'ü' => 'u', 'ñ' => 'n']);
    return preg_replace('/\s+/', ' ', $t);
}

const PATRONES_CRISIS = [
    // Riesgo de autolesión o suicidio
    'autolesion' => [
        '/\bsuicid/', '/\bmatarme\b/', '/\bquitarme la vida\b/', '/\bacabar con mi vida\b/',
        '/\bquiero morir(me)?\b/', '/\bme quiero morir\b/', '/\bno quiero (seguir )?vivir\b/',
        '/\bya no quiero estar aqui\b/', '/\bdesaparecer para siempre\b/',
        '/\b(hacerme|me quiero hacer|me voy a hacer|me hago) dano\b/', '/\blastimarme\b/',
        '/\bcortarme\b/', '/\bme corto\b/', '/\bautolesi/', '/\bno vale la pena vivir\b/',
    ],
    // Preguntas de cantidades de medicamento que pueden indicar sobredosis
    'sobredosis' => [
        '/\bcuantas (pastillas|tabletas|capsulas)\b/', '/\bsobredosis\b/',
        '/\b(pastillas|tabletas) para (no despertar|morir)\b/', '/\btomarme (todas|todo el frasco)\b/',
    ],
    // Emergencia médica
    'emergencia' => [
        '/\bdolor (fuerte |intenso )?(en el|de) pecho\b/', '/\bno puedo respirar\b/', '/\bme estoy (ahogando|desmayando)\b/',
        '/\bconvulsi/', '/\bperdi el conocimiento\b/', '/\bsangr\w* (mucho|sin parar)\b/', '/\bparalisis\b/',
        '/\bno siento (la cara|el brazo|la pierna)\b/',
    ],
    // Señales de trastorno de la conducta alimentaria
    'tca' => [
        '/\bno (he )?comido (en|hace) (varios|\d+) dias\b/', '/\bme provoco el vomito\b/', '/\bvomito a proposito\b/',
        '/\bme purgo\b/', '/\b(laxantes|diureticos) para (bajar|adelgazar)\b/',
    ],
];

/** Devuelve el tipo de crisis detectado o null. */
function detectarCrisis(string $mensaje): ?string {
    $t = normalizarTexto($mensaje);
    foreach (PATRONES_CRISIS as $tipo => $patrones) {
        foreach ($patrones as $p) {
            if (preg_match($p, $t)) return $tipo;
        }
    }
    return null;
}

/** Mensaje fijo, revisado, para cada tipo de crisis. */
function mensajeCrisis(string $tipo): string {
    $linea = LINEA_AYUDA_NOMBRE . ': ' . LINEA_AYUDA_TEL . ' (gratis, 24 horas)';
    return match ($tipo) {
        'autolesion' =>
            "💜 Gracias por contármelo. Lo que sientes es importante y no tienes que pasarlo solo/a.\n\n"
            . "Por favor habla hoy con alguien que pueda ayudarte:\n"
            . "• {$linea}\n"
            . "• Si estás en peligro inmediato, llama al 911.\n\n"
            . "También puedes contárselo a alguien de confianza o pedir una cita en el módulo de Psicología. Aquí sigo para escucharte.",
        'sobredosis' =>
            "No puedo darte cantidades de medicamentos. Tomar de más puede ser muy peligroso, incluso con medicamentos comunes.\n\n"
            . "Si tienes dudas sobre una dosis, pregúntale a tu médico o farmacéutico. "
            . "Si estás pensando en hacerte daño, habla hoy con alguien:\n"
            . "• {$linea}\n• Emergencias: 911",
        'emergencia' =>
            "🚨 Lo que describes puede ser una emergencia médica. Llama al 911 o ve a urgencias ahora. "
            . "Si estás haciendo ejercicio, detente de inmediato y no te quedes solo/a.",
        'tca' =>
            "Gracias por contarlo. Dejar de comer o provocarte el vómito puede dañar mucho tu cuerpo, y no tienes que enfrentarlo solo/a.\n\n"
            . "Te recomiendo hablar con un profesional de salud o pedir una cita en Psicología o Clínico. "
            . "Si sientes que necesitas ayuda ahora: {$linea}.",
        default => "Si necesitas ayuda ahora: {$linea}. Emergencias: 911.",
    };
}
