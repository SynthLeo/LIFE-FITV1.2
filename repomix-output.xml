                )}
                {pasoActivo === tecnica.pasos.length - 1 && (
                  <div className="flex-1 py-2 rounded-xl text-xs text-center" style={{ background: 'rgba(34,197,94,0.1)', color: '#4ade80', border: '1px solid rgba(34,197,94,0.2)' }}>
