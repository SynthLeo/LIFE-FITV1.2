-        ? htmlspecialchars(strip_tags((string) $input[$campo]), ENT_QUOTES, 'UTF-8')
-        : null;
-}
-
-// ── Validaciones ──────────────────────────────────────────────────────────────
-$score = (int) ($datos['nutricion_score'] ?? 0);
-if ($score < 0 || $score > 100) {
-    http_response_code(422);
-    echo json_encode(['error' => 'Score fuera de rango']);
-    exit;
-}
-
-$nivelesValidos = ['deficiente', 'mejorable', 'adecuado', 'optimo'];
-if (!in_array($datos['nivel_nutricion'], $nivelesValidos, true)) {
-    http_response_code(422);
-    echo json_encode(['error' => 'Nivel nutricional no válido']);
-    exit;
-}
-
-// ── Persistencia ──────────────────────────────────────────────────────────────
-try {
-    $db  = ConexionDB::getInstance()->getConexion();
-    $uid = (int) $usuario['id'];
-
-    $stmt = $db->prepare('
-        INSERT INTO cuestionarios_alimentacion (
-            usuario_id,
-            objetivo, frecuencia_comidas, desayuno,
-            verduras_frutas, proteina, ultra_procesados,
-            agua, alergias, presupuesto,
