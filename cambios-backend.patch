+++ b/Api/Cuestionario/Seguimiento.php
@@ -0,0 +1,85 @@
+<?php
+// ============================================================
+//  Api/Cuestionario/Seguimiento.php — PHQ-8 + GAD-7 cada 2 semanas (M3)
+//  GET  → { mediciones:[{fecha, phq8, gad7}], toca, dias_para_siguiente }
+//         (la primera medición es la del onboarding)
+//  POST { respuestas: { phq_interes: 0-3, …, gad_miedo: 0-3 } }
+//       → guarda una medición NUEVA y dice si empeoró.
+//  Datos sensibles: solo los ve el propio usuario.
+// ============================================================
+
+require_once __DIR__ . '/../../Seguridad/Cors.php';
+require_once __DIR__ . '/../../Seguridad/Autenticacion.php';
+require_once __DIR__ . '/../../utils/api.php';
+require_once __DIR__ . '/../../utils/consentimiento.php';
+
+const SEG_PHQ  = ['phq_interes', 'phq_animo', 'phq_sueno', 'phq_energia', 'phq_apetito', 'phq_autoestima', 'phq_concentracion', 'phq_movimiento'];
+const SEG_GAD  = ['gad_nervios', 'gad_control', 'gad_preocupacion', 'gad_relajarse', 'gad_inquietud', 'gad_irritable', 'gad_miedo'];
+const SEG_DIAS = 14;
+const SEG_CAMBIO_IMPORTANTE = 5;   // 5 puntos = cambio clínicamente relevante en PHQ/GAD
+
+$uid = (int) $GLOBALS['userId'];
+
+function medicionesDe(PDO $db, int $uid): array {
+    $base = $db->prepare('SELECT fecha_registro AS fecha, phq8_total AS phq8, gad7_total AS gad7
+                          FROM cuestionarios_psicologicos WHERE usuario_id = ? AND phq8_total IS NOT NULL');
+    $base->execute([$uid]);
+    $seg = $db->prepare('SELECT created_at AS fecha, phq8_total AS phq8, gad7_total AS gad7
+                         FROM seguimiento_animo WHERE id_usuario = ? ORDER BY created_at');
+    $seg->execute([$uid]);
+    $todas = array_merge($base->fetchAll(), $seg->fetchAll());
+    return array_map(fn($m) => ['fecha' => $m['fecha'], 'phq8' => (int) $m['phq8'], 'gad7' => (int) $m['gad7']], $todas);
+}
+
+function estadoSeguimiento(array $mediciones): array {
+    if (!$mediciones) return ['toca' => false, 'dias_para_siguiente' => null];
+    $ultima = new DateTime(end($mediciones)['fecha']);
+    $dias   = (int) $ultima->diff(new DateTime())->days;
+    return ['toca' => $dias >= SEG_DIAS, 'dias_para_siguiente' => max(0, SEG_DIAS - $dias)];
+}
+
+try {
+    $db = getDB();
+
+    if ($_SERVER['REQUEST_METHOD'] === 'GET') {
+        $m = medicionesDe($db, $uid);
+        salir(200, ['ok' => true, 'mediciones' => $m] + estadoSeguimiento($m));
+    }
+
+    exigirMetodo('POST');
+    exigirConsentimiento($db, $uid);
+
+    $r = jsonBody()['respuestas'] ?? null;
+    if (!is_array($r)) salir(422, ['error' => 'Faltan las respuestas.']);
+    $limpias = [];
+    foreach (array_merge(SEG_PHQ, SEG_GAD) as $id) {
+        $v = $r[$id] ?? null;
+        if (!is_numeric($v) || (int) $v != $v || $v < 0 || $v > 3) salir(422, ['error' => "Respuesta inválida o faltante: $id."]);
+        $limpias[$id] = (int) $v;
+    }
+    $phq8 = array_sum(array_intersect_key($limpias, array_flip(SEG_PHQ)));
+    $gad7 = array_sum(array_intersect_key($limpias, array_flip(SEG_GAD)));
+
+    $antes = medicionesDe($db, $uid);
+    if (!estadoSeguimiento($antes)['toca'] && $antes) {
+        salir(429, ['error' => 'Todavía no toca. El seguimiento es cada 2 semanas.'] + estadoSeguimiento($antes));
+    }
+
+    $db->prepare('INSERT INTO seguimiento_animo (id_usuario, phq8_total, gad7_total, respuestas) VALUES (?, ?, ?, ?)')
+       ->execute([$uid, $phq8, $gad7, json_encode($limpias)]);
+} catch (Throwable $e) {
+    errorInterno('Seguimiento', $e);
+}
+
+$previa  = $antes ? end($antes) : null;
+$empeoro = $previa && ($phq8 - $previa['phq8'] >= SEG_CAMBIO_IMPORTANTE || $gad7 - $previa['gad7'] >= SEG_CAMBIO_IMPORTANTE);
+$peor    = max($phq8, $gad7);
+
+salir(200, [
+    'ok'               => true,
+    'phq8'             => $phq8,
+    'gad7'             => $gad7,
+    'empeoro'          => $empeoro,
+    'sugerir_consulta' => $empeoro || $peor >= 10,
+    'mostrar_linea'    => $peor >= 15,
+]);
diff --git a/Api/IA/Diagnostico.php b/Api/IA/Diagnostico.php
new file mode 100644
index 0000000..a6dbe8a
--- /dev/null
+++ b/Api/IA/Diagnostico.php
@@ -0,0 +1,96 @@
+<?php
+// ============================================================
+//  POST Api/IA/Diagnostico.php — diagnóstico del onboarding
+//
+//  Lee los 4 cuestionarios ya guardados, arma un RESUMEN
+//  (no manda las respuestas crudas) y pide a la IA un JSON
+//  con esquema. Si la IA falla, responde un diagnóstico básico
+//  calculado aquí, para que el onboarding nunca se quede trabado.
+// ============================================================
+
+require_once __DIR__ . '/../../Seguridad/Cors.php';
+require_once __DIR__ . '/../../Seguridad/Autenticacion.php';
+require_once __DIR__ . '/../../utils/api.php';
+require_once __DIR__ . '/../../utils/instrumentos.php';
+require_once __DIR__ . '/../../ia/llm.php';
+require_once __DIR__ . '/../../ia/prompts.php';
+
+exigirMetodo('POST');
+
+$uid = (int) $GLOBALS['userId'];
+$db  = getDB();
+
+$leer = function (string $sql) use ($db, $uid) {
+    $st = $db->prepare($sql);
+    $st->execute([$uid]);
+    return $st->fetch() ?: [];
+};
+$ej = $leer('SELECT nivel_recomendado, ipaq_categoria, ipaq_met_min, parq_resultado, ipaq_sentado FROM cuestionario_habitos WHERE id_usuario = ?');
+$cl = $leer('SELECT nivel_salud, salud_score, presion_dx, glucosa_dx, colesterol_dx, sueno_horas, tabaco_actual, vapeo_actual, chequeo_ultimo, vacunas FROM cuestionarios_clinicos WHERE usuario_id = ?');
+$ps = $leer('SELECT nivel_psicologico, metas_bienestar FROM cuestionarios_psicologicos WHERE usuario_id = ?');
+$al = $leer('SELECT nivel_nutricion, nutricion_score, objetivo FROM cuestionarios_alimentacion WHERE usuario_id = ?');
+$us = $leer('SELECT nombre, peso_kg, altura_cm, fecha_nacimiento FROM usuario WHERE id_usuario = ?');
+
+$imc = (!empty($us['peso_kg']) && !empty($us['altura_cm'])) ? round($us['peso_kg'] / (($us['altura_cm'] / 100) ** 2), 1) : null;
+$resumen = [
+    'edad'       => edadDesde($us['fecha_nacimiento'] ?? null),
+    'imc'        => $imc,
+    'ejercicio'  => ['nivel' => $ej['nivel_recomendado'] ?? null, 'actividad_ipaq' => $ej['ipaq_categoria'] ?? null, 'met_min_semana' => $ej['ipaq_met_min'] ?? null, 'par_q' => $ej['parq_resultado'] ?? null, 'horas_sentado' => $ej['ipaq_sentado'] ?? null],
+    'clinico'    => ['nivel' => $cl['nivel_salud'] ?? null, 'puntaje' => $cl['salud_score'] ?? null, 'presion' => $cl['presion_dx'] ?? null, 'glucosa' => $cl['glucosa_dx'] ?? null, 'sueno' => $cl['sueno_horas'] ?? null, 'tabaco' => $cl['tabaco_actual'] ?? null, 'vapeo' => $cl['vapeo_actual'] ?? null, 'ultimo_chequeo' => $cl['chequeo_ultimo'] ?? null],
+    'nutricion'  => ['nivel' => $al['nivel_nutricion'] ?? null, 'puntaje' => $al['nutricion_score'] ?? null, 'objetivo' => $al['objetivo'] ?? null],
+    'psicologia' => ['bienestar' => $ps['nivel_psicologico'] ?? null, 'meta' => $ps['metas_bienestar'] ?? null],
+];
+
+// ── Diagnóstico de respaldo (sin IA) ──────────────────────────
+function diagnosticoBasico(array $r): array {
+    $ejN = ['principiante' => 'Principiante', 'intermedio' => 'Intermedio', 'avanzado' => 'Avanzado'][$r['ejercicio']['nivel'] ?? ''] ?? 'Principiante';
+    $clN = ['optimo' => 'Óptimo', 'bueno' => 'Bueno'][$r['clinico']['nivel'] ?? ''] ?? 'Atención requerida';
+    $nuN = ['optimo' => 'Excelente', 'adecuado' => 'Adecuada'][$r['nutricion']['nivel'] ?? ''] ?? 'Mejorable';
+    $psN = ['resiliente' => 'Estable', 'moderado' => 'Moderado'][$r['psicologia']['bienestar'] ?? ''] ?? 'Requiere apoyo';
+    $prioridad = $psN === 'Requiere apoyo' ? 'psicologia' : ($clN === 'Atención requerida' ? 'clinico' : ($nuN === 'Mejorable' ? 'nutricion' : 'ejercicio'));
+    return [
+        'resumen' => 'Ya tenemos tu perfil de salud. Revisa cada módulo para ver tus recomendaciones y empieza por tu prioridad.',
+        'modulos' => [
+            'ejercicio'  => ['nivel' => $ejN, 'observacion' => 'Tu nivel se calculó con tu actividad de los últimos 7 días (IPAQ).', 'recomendacion' => ($r['ejercicio']['par_q'] ?? '') === 'consultar' ? 'Consulta a un profesional antes de subir la intensidad.' : 'Sigue tu rutina y aumenta la carga poco a poco.'],
+            'clinico'    => ['nivel' => $clN, 'observacion' => 'Calculado con tus hábitos y antecedentes de salud.', 'recomendacion' => 'Hazte un chequeo preventivo al año.'],
+            'nutricion'  => ['nivel' => $nuN, 'observacion' => 'Calculado con tus hábitos de alimentación de la semana.', 'recomendacion' => 'Revisa tu plan semanal en el módulo de Nutrición.'],
+            'psicologia' => ['nivel' => $psN, 'observacion' => 'Basado en el tamizaje de ánimo y ansiedad de las últimas 2 semanas.', 'recomendacion' => $psN === 'Requiere apoyo' ? 'Te recomendamos agendar una cita en el módulo de Psicología.' : 'Practica alguna técnica de bienestar esta semana.'],
+        ],
+        'prioridad'        => $prioridad,
+        'frase_motivadora' => 'Cada pequeño paso cuenta. ¡Vamos!',
+        'generado_por'     => 'reglas',
+    ];
+}
+
+$diag = null;
+if (llmPermitido($uid, 'diagnostico')) {
+    $r = llmChat(promptDiagnostico($resumen), [
+        'temperature'   => 0.4,
+        'max_tokens'    => 900,
+        'timeout'       => 150,
+        'json_schema'   => esquemaDiagnostico(),
+        'nombre_schema' => 'diagnostico',
+    ]);
+    $j = $r['ok'] ? ($r['json'] ?? llmExtraerJSON($r['content'])) : null;
+    $base = diagnosticoBasico($resumen);
+    if (is_array($j) && isset($j['modulos']) && is_array($j['modulos'])) {
+        // Se valida campo por campo; lo que no cumpla se toma del diagnóstico básico
+        $diag = $base;
+        $diag['generado_por'] = 'ia';
+        if (is_string($j['resumen'] ?? null))          $diag['resumen'] = mb_substr(strip_tags($j['resumen']), 0, 500);
+        if (is_string($j['frase_motivadora'] ?? null)) $diag['frase_motivadora'] = mb_substr(strip_tags($j['frase_motivadora']), 0, 150);
+        if (in_array($j['prioridad'] ?? null, ['ejercicio', 'clinico', 'nutricion', 'psicologia'], true)) $diag['prioridad'] = $j['prioridad'];
+        foreach (['observacion', 'recomendacion'] as $campo) {
+            foreach ($diag['modulos'] as $m => $_) {
+                if (is_string($j['modulos'][$m][$campo] ?? null)) $diag['modulos'][$m][$campo] = mb_substr(strip_tags($j['modulos'][$m][$campo]), 0, 300);
+            }
+        }
+        // Los NIVELES salen de los instrumentos, no del modelo
+        // Seguridad: si el tamizaje marcó apoyo, la IA no puede bajarle la prioridad
+        if ($base['modulos']['psicologia']['nivel'] === 'Requiere apoyo') $diag['prioridad'] = 'psicologia';
+    } else {
+        error_log('[Diagnostico] IA sin JSON válido: ' . ($r['error'] ?? 'formato'));
+    }
+}
+
+salir(200, ['ok' => true, 'diagnostico' => $diag ?? diagnosticoBasico($resumen)]);
diff --git a/Api/IA/GenerarDieta.php b/Api/IA/GenerarDieta.php
new file mode 100644
index 0000000..e89b028
--- /dev/null
+++ b/Api/IA/GenerarDieta.php
@@ -0,0 +1,113 @@
+<?php
+// ============================================================
+//  POST Api/IA/GenerarDieta.php — plan semanal de comidas con IA
+//
+//  Body (todo opcional):
+//   { respuestas: {…respuestas del cuestionario de alimentación…},
+//     guardar: true }
+//  - Sin "respuestas": usa el perfil guardado del usuario.
+//  - Con "guardar": actualiza solo plan_semanal (si el perfil ya existe).
+//
+//  El prompt se arma en el servidor, el modelo responde con JSON
+//  según un esquema, y el plan se valida antes de devolverlo.
+//  Calorías: Mifflin-St Jeor × actividad, nunca menos de 1,400.
+// ============================================================
+
+require_once __DIR__ . '/../../Seguridad/Cors.php';
+require_once __DIR__ . '/../../Seguridad/Autenticacion.php';
+require_once __DIR__ . '/../../utils/api.php';
+require_once __DIR__ . '/../../utils/instrumentos.php';
+require_once __DIR__ . '/../../utils/dieta.php';
+require_once __DIR__ . '/../../utils/helpers.php';
+require_once __DIR__ . '/../../ia/llm.php';
+require_once __DIR__ . '/../../ia/prompts.php';
+
+exigirMetodo('POST');
+
+$uid  = (int) $GLOBALS['userId'];
+$body = jsonBody();
+$db   = getDB();
+
+// ── 1. Contexto: respuestas recién contestadas o perfil guardado ──
+try {
+    if (!empty($body['respuestas']) && is_array($body['respuestas'])) {
+        $ctx = limpiarRespuestas('alimentacion', $body['respuestas']);
+    } else {
+        $st = $db->prepare('SELECT * FROM cuestionarios_alimentacion WHERE usuario_id = ? LIMIT 1');
+        $st->execute([$uid]);
+        $fila = $st->fetch();
+        if (!$fila) salir(422, ['error' => 'Primero completa el cuestionario de alimentación.']);
+        $ctx = limpiarRespuestas('alimentacion', $fila);
+    }
+} catch (InvalidArgumentException $e) {
+    salir(422, ['error' => $e->getMessage()]);
+}
+
+// ── 2. Calorías objetivo (si hay peso y altura) ───────────────
+$st = $db->prepare('SELECT peso_kg, altura_cm, fecha_nacimiento, sexo_biologico FROM usuario WHERE id_usuario = ?');
+$st->execute([$uid]);
+$u = $st->fetch() ?: [];
+$kcalObjetivo = null;
+if (!empty($u['peso_kg']) && !empty($u['altura_cm'])) {
+    $tmb    = calcularTMB((float) $u['peso_kg'], (int) $u['altura_cm'], calcularEdad($u['fecha_nacimiento'] ?? null), $u['sexo_biologico'] ?? null);
+    $factor = ['sedentario' => 1.2, 'leve' => 1.375, 'moderado' => 1.55, 'intenso' => 1.725][$ctx['actividad_fisica_alim'] ?? ''] ?? 1.375;
+    $ajuste = ['perder_peso' => 0.85, 'ganar_masa' => 1.10][$ctx['objetivo'] ?? ''] ?? 1.0;   // déficit moderado, nunca agresivo
+    $edadU  = calcularEdad($u['fecha_nacimiento'] ?? null);
+    if ($edadU !== null && $edadU < 18 && $ajuste < 1.0) $ajuste = 1.0;   // menores: sin déficit calórico (siguen creciendo)
+    $kcalObjetivo = (int) (round(max(KCAL_MINIMO_SEGURO, min(3200, $tmb * $factor * $ajuste)) / 50) * 50);
+}
+
+// ── 3. Hábitos a mejorar (preguntas con 0 o 1 punto) ──────────
+$textos = [
+    'verduras_dias' => 'más verduras', 'frutas_dias' => 'más fruta', 'lacteos_dias' => 'lácteos naturales',
+    'agua_vasos' => 'más agua natural', 'carnes_procesadas' => 'menos embutidos', 'comida_rapida' => 'menos comida rápida',
+    'dulces' => 'menos dulces', 'pan_dulce' => 'menos pan dulce', 'botanas' => 'menos botanas',
+    'refrescos_dias' => 'menos refresco', 'desayuno_dias' => 'desayunar diario',
+];
+$habitos = [];
+foreach ($textos as $id => $t) {
+    if (($ctx[$id] ?? null) !== null && (int) opcionDato('alimentacion', $id, $ctx) <= 1) $habitos[] = $t;
+}
+
+// ── 4. IA ─────────────────────────────────────────────────────
+if (!llmPermitido($uid, 'dieta')) salir(429, ['error' => 'Espera un minuto antes de generar otro plan.']);
+
+$menorDeEdad = isset($edadU) && $edadU !== null && $edadU < 18;
+if ($menorDeEdad && ($ctx['objetivo'] ?? '') === 'perder_peso') $ctx['objetivo'] = 'mejorar_salud';
+$mensajes = promptDieta($ctx + ['kcal_objetivo' => $kcalObjetivo, 'habitos' => implode(', ', array_slice($habitos, 0, 5))]);
+$plan  = null;
+$ultimoError = '';
+for ($intento = 1; $intento <= 2 && $plan === null; $intento++) {
+    $r = llmChat($mensajes, [
+        'temperature'   => 0.4,
+        'max_tokens'    => 3000,
+        'timeout'       => 240,
+        'json_schema'   => esquemaPlanDieta(),
+        'nombre_schema' => 'plan_semanal',
+    ]);
+    if (!$r['ok']) { $ultimoError = $r['error']; break; }   // si LM Studio no responde, no tiene caso reintentar
+    try {
+        $plan = validarPlanDieta($r['json'] ?? llmExtraerJSON($r['content']));
+    } catch (InvalidArgumentException $e) {
+        $ultimoError = $e->getMessage();
+        error_log("[GenerarDieta] intento $intento inválido: $ultimoError");
+    }
+}
+if ($plan === null) {
+    error_log('[GenerarDieta] ' . $ultimoError);
+    salir(503, ['error' => 'No se pudo generar el plan. Revisa que LM Studio esté corriendo e intenta de nuevo.']);
+}
+
+// ── 5. Guardar (solo plan_semanal) ────────────────────────────
+$guardado = false;
+if (!empty($body['guardar'])) {
+    try {
+        $st = $db->prepare('UPDATE cuestionarios_alimentacion SET plan_semanal = ?, fecha_actualizacion = NOW() WHERE usuario_id = ?');
+        $st->execute([json_encode($plan, JSON_UNESCAPED_UNICODE), $uid]);
+        $guardado = $st->rowCount() > 0;
+    } catch (Throwable $e) {
+        errorInterno('GenerarDieta', $e);
+    }
+}
+
+salir(200, ['ok' => true, 'plan' => $plan, 'guardado' => $guardado, 'kcal_objetivo' => $kcalObjetivo]);
