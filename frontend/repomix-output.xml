// ── Componente del modelo anatómico ─────────────────────────────────────────
function AnatomicalModel({
  diasMap,
  hoveredGroup,
  setHoveredGroup,
  selectedGroup,
  setSelectedGroup,
  sexoBiologico = 'masculino',
}) {
  const [isBack,   setIsBack]   = useState(false)
  const [flipping, setFlipping] = useState(false)

  const isFem       = sexoBiologico === 'femenino'
  const accentColor = isFem ? '#ff6eb4' : '#00e5ff'
  const glowColor   = isFem
    ? 'radial-gradient(ellipse at 50% 40%, rgba(255,110,180,0.12), transparent 70%)'
    : 'radial-gradient(ellipse at 50% 40%, rgba(0,229,255,0.10), transparent 70%)'

  const modelKey = `${isBack ? 'back' : 'front'}_${isFem ? 'fem' : 'masc'}`

  const PATHS_MAP_LOCAL = {
    front_masc: PATHS_FRONT_MASC,
    back_masc:  PATHS_BACK_MASC.paths,
    front_fem:  PATHS_FRONT_FEM.paths,
    back_fem:   PATHS_BACK_FEM.paths,
  }
  const GRUPOS_MAP = {
    front_masc: GRUPOS_FRONT,
    back_masc:  GRUPOS_BACK_MASC,
    front_fem:  GRUPOS_FRONT_FEM,
    back_fem:   GRUPOS_BACK_FEM,
  }
  
  const VIEWBOX_MAP = {
    front_masc: '615 140 140 570',
    back_masc:  '30 0 300 717',
    front_fem:  '60 130 150 620',
    back_fem:   '75 130 145 640',
  }
  const TRANSFORM_MAP = {
    front_masc: null,
    back_masc:  'translate(0,717) scale(0.1,-0.1)',
    front_fem:  'matrix(0.1,0,0,-0.1,-81,861.97475)',
    back_fem:   'matrix(0.1,0,0,-0.1,-9.4075026,877.63124)',
  }

  const currentPaths  = PATHS_MAP_LOCAL[modelKey] ?? {}
  const currentGrupos = GRUPOS_MAP[modelKey]       ?? {}
  const viewBox       = VIEWBOX_MAP[modelKey]
  const transform     = TRANSFORM_MAP[modelKey]
  const needsTransform = !!transform

  const getColor = useCallback((label) => {
    if (selectedGroup === label)
      return {
        fill:   isFem ? '#3d0020' : '#0a2a40',
        stroke: accentColor,
        glow:   `0 0 16px ${accentColor}99`,
        hex:    accentColor,
        badge:  'fresh',
      }
    if (hoveredGroup === label)
      return { fill: '#2a1a00', stroke: '#f1c40f', glow: '0 0 12px #f39c1288', hex: '#f39c12', badge: 'good' }
    return colorPorDias(diasMap[label] ?? null)
  }, [diasMap, hoveredGroup, selectedGroup, isFem, accentColor])

  const handleFlip = () => {
    setFlipping(true)
    setTimeout(() => {
      setIsBack(b => !b)
      setSelectedGroup(null)
      setFlipping(false)
    }, 180)
  }

  const renderGrupos = (strokeMultiplier = 1) =>
    Object.entries(currentGrupos).map(([label, pathIds]) => {
      const c = getColor(label)
      const isSelected = selectedGroup === label
      return (
        <g
          key={label}
          style={{ cursor: 'pointer' }}
          onClick={() => setSelectedGroup(selectedGroup === label ? null : label)}
          onMouseEnter={() => setHoveredGroup(label)}
          onMouseLeave={() => setHoveredGroup(null)}
        >
          {pathIds.map(pid => currentPaths[pid] && (
            <path
              key={pid}
              d={currentPaths[pid]}
              fill={c.fill}
              stroke={c.stroke}
              strokeWidth={isSelected ? 2 * strokeMultiplier : 1 * strokeMultiplier}
              strokeLinejoin="round"
              style={{
                filter: c.glow !== 'none' ? `drop-shadow(${c.glow})` : undefined,
                transition: 'fill 0.2s, stroke 0.2s, filter 0.2s',
                opacity: selectedGroup && selectedGroup !== label ? 0.3 : 1,
              }}
            />
          ))}
        </g>
      )
    })

  return (
    <div className="flex flex-col h-full w-full">

      {/* Header con badge de sexo/vista y botón rotar */}
      <div
        className="flex items-center justify-between px-4 py-3 border-b border-border/60"
        style={{ background: 'var(--surface-2)' }}
      >
        <div className="flex items-center gap-2">
          <span
            className="w-2 h-2 rounded-full animate-pulse"
            style={{ background: accentColor, boxShadow: `0 0 8px ${accentColor}` }}
          />
          <span
            className="text-xs font-semibold tracking-widest uppercase"
            style={{ fontFamily: 'monospace', color: accentColor }}
          >
            {isFem ? '♀ Femenino' : '♂ Masculino'} · {isBack ? 'Posterior' : 'Frontal'}
          </span>
        </div>

        <button
          onClick={handleFlip}
          className="text-xs px-2.5 py-1 rounded border transition-all hover:opacity-80 active:scale-95 select-none"
          style={{
            fontFamily: 'monospace',
            color: accentColor,
            borderColor: `${accentColor}40`,
            background: `${accentColor}0f`,
          }}
        >
          {isBack ? '← Frontal' : 'Posterior →'}
        </button>
      </div>

      {/* SVG con fade al cambiar vista */}
      <div
        className="flex-1 flex items-center justify-center relative overflow-hidden"
        style={{
          background: 'var(--color-background)',
          minHeight: 520,
          transition: 'opacity 0.18s ease',
          opacity: flipping ? 0 : 1,
        }}
      >
        {/* Glow ambiental */}
        <div style={{ position: 'absolute', inset: 0, background: glowColor, pointerEvents: 'none' }} />

        <svg viewBox={viewBox} width="100%" height="100%" style={{ display: 'block', maxHeight: needsTransform ? 580 : 520 }}>
          {needsTransform ? (
            <g transform={transform}>
              {renderGrupos(15)}
            </g>
          ) : (
            <>
              <ellipse cx="683" cy="148" rx="28" ry="33" fill="var(--surface-3)" stroke="var(--border-medium)" strokeWidth="1" />
              <rect x="610" y="178" width="146" height="170" rx="6" fill="var(--surface-3)" stroke="var(--border-medium)" strokeWidth="1" />
              <polygon
                points="610,348 540,420 545,690 620,690 620,500 650,500 683,690 716,690 716,500 746,500 746,690 821,690 826,420 756,348"
                fill="var(--surface-3)" stroke="var(--border-medium)" strokeWidth="1"
              />
              {renderGrupos(1)}
            </>
          )}
        </svg>
      </div>
    </div>
  )
}

