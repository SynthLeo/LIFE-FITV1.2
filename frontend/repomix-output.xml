                      <p className="sp-feed-time">{item.hace}</p>
                    </div>
                  </div>

                  {/* Actions */}
                  <div className="sp-feed-actions">
                    <button
                      className={`sp-like-btn ${likeState.liked ? 'liked' : ''}`}
