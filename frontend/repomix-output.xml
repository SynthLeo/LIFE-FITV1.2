// ── Color por días sin entrenar ──────────────────────────────────────────────
function colorPorDias(dias) {
  if (dias === null || dias === undefined)
    return { fill: '#1c1c1c', stroke: '#2a2a2a', glow: 'none', label: 'Sin datos', hex: '#444', badge: 'neutral' }
  if (dias <= 2)
    return { fill: '#00b09b', stroke: '#00cec9', glow: '0 0 10px #00b09b88', label: `${dias}d`, hex: '#00b09b', badge: 'fresh' }
  if (dias <= 5)
    return { fill: '#27ae60', stroke: '#2ecc71', glow: '0 0 8px #27ae6066', label: `${dias}d`, hex: '#27ae60', badge: 'good' }
  if (dias <= 9)
    return { fill: '#1a6fa8', stroke: '#3498db', glow: '0 0 8px #1a6fa866', label: `${dias}d`, hex: '#3498db', badge: 'rest' }
  return   { fill: '#c0392b', stroke: '#e74c3c', glow: '0 0 14px #c0392b88', label: `${dias}d`, hex: '#e74c3c', badge: 'alert' }
}

