                      <span className="text-[10px] font-mono text-muted-foreground whitespace-nowrap pt-0.5">
                        ~{c.kcal} kcal
                      </span>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        )
      })}
    </div>
  )
}

