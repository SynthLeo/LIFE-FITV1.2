                <span className="text-lg">🩺</span>
                <div>
                  <p className="text-xs font-semibold text-foreground">Perfil clínico activo</p>
                  <p className="text-[10px] text-muted-foreground">Indicador: {perfilClinico.salud_score}/100 · {perfilClinico.nivel_salud?.replace('_',' ')}</p>
                </div>
              </div>
