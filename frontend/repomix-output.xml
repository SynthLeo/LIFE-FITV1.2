<file path="src/presentacion/componentes/cuestionario/Cuestionario.css">
/* Estilos del componente <Cuestionario> (los 4 cuestionarios).
   El color de cada módulo llega por variables: --cq-color y --cq-rgb ("r,g,b").
   Usa las fuentes ya empaquetadas en la app (sin @import de Google Fonts). */

.cq-wrap { background:var(--color-background); min-height:100vh; color:var(--color-foreground); }

.cq-header { background:var(--color-background); border-bottom:1px solid var(--border-subtle); height:62px; display:flex; align-items:center; padding:0 24px; gap:16px; position:sticky; top:0; z-index:100; }
.cq-back { background:none; border:none; color:var(--color-muted-foreground); cursor:pointer; font-size:0.875rem; display:flex; align-items:center; gap:6px; padding:6px 0; transition:color 160ms; flex-shrink:0; }
.cq-back:hover { color:var(--color-foreground); }
.cq-header-title { font-size:1rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; flex:1; text-align:center; }
.cq-counter { font-family:ui-monospace,monospace; font-size:0.65rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-muted-foreground); min-width:44px; text-align:right; flex-shrink:0; }

.cq-progress { background:var(--color-background); border-bottom:1px solid var(--border-subtle); padding:12px 24px; position:sticky; top:62px; z-index:99; }
.cq-progress-meta { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.cq-cat-tag { font-family:ui-monospace,monospace; font-size:0.58rem; letter-spacing:0.16em; text-transform:uppercase; color:var(--cq-color); background:rgba(var(--cq-rgb),0.07); border:1px solid rgba(var(--cq-rgb),0.22); padding:3px 9px; display:inline-block; }
.cq-pct-label { font-family:ui-monospace,monospace; font-size:0.62rem; color:var(--color-muted-foreground); }
.cq-track { height:3px; background:var(--surface-2); overflow:hidden; }
.cq-fill { height:100%; background:var(--cq-color); transition:width 400ms cubic-bezier(0.4,0,0.2,1); }

.cq-main { max-width:600px; margin:0 auto; padding:36px 24px 120px; }

@keyframes cqIn   { from { opacity:0; transform:translateX(30px); } to { opacity:1; transform:translateX(0); } }
@keyframes cqOut  { from { opacity:1; transform:translateX(0); }   to { opacity:0; transform:translateX(-30px); } }
@keyframes cqFade { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } }
@keyframes cqSpin { to { transform:rotate(360deg); } }
@keyframes cqRing { from { stroke-dashoffset:440; } to { stroke-dashoffset:var(--cq-ring-offset); } }
.cq-in   { animation:cqIn  280ms cubic-bezier(0.16,1,0.3,1) forwards; }
.cq-out  { animation:cqOut 240ms ease forwards; }
.cq-fade { animation:cqFade 400ms ease both; }
.cq-ring-fg { animation:cqRing 1.2s cubic-bezier(0.4,0,0.2,1) 0.4s both; }

.cq-q-wrap { position:relative; border:0; margin:0; padding:0; min-width:0; }
.cq-ghost-num { font-weight:900; font-size:7rem; line-height:1; color:var(--color-foreground); opacity:0.04; position:absolute; top:-24px; right:-4px; user-select:none; pointer-events:none; }
.cq-q-title { font-size:1.125rem; font-weight:500; line-height:1.55; margin:0 0 26px; padding:0 40px 0 0; float:left; width:100%; }
.cq-q-help { clear:both; font-size:0.82rem; line-height:1.5; color:var(--color-muted-foreground); margin:-14px 0 22px; padding-right:40px; }

.cq-opts { clear:both; display:flex; flex-direction:column; gap:8px; }
.cq-opt { display:flex; align-items:center; gap:14px; padding:15px 18px; background:var(--color-card); border:1px solid var(--border-subtle); border-left:3px solid transparent; cursor:pointer; transition:background 160ms,border-color 160ms; user-select:none; }
.cq-opt:hover { border-left-color:rgba(var(--cq-rgb),0.3); }
.cq-opt.active { background:rgba(var(--cq-rgb),0.07); border-color:rgba(var(--cq-rgb),0.3); border-left-color:var(--cq-color); }
.cq-opt:focus-within { outline:2px solid var(--cq-color); outline-offset:2px; }
.cq-opt input { position:absolute; opacity:0; width:1px; height:1px; pointer-events:none; }
.cq-radio { width:19px; height:19px; border:2px solid var(--border-medium); border-radius:50%; flex-shrink:0; position:relative; transition:border-color 160ms,background 160ms; }
.cq-opt.active .cq-radio { border-color:var(--cq-color); background:var(--cq-color); }
.cq-opt.active .cq-radio::after { content:''; position:absolute; inset:4px; background:var(--color-background); border-radius:50%; }
.cq-opt-label { font-size:0.9rem; font-weight:500; line-height:1.3; }
.cq-opt-desc { font-size:0.76rem; color:var(--color-muted-foreground); margin-top:2px; line-height:1.35; }

.cq-error { font-family:ui-monospace,monospace; font-size:0.65rem; color:#ef4444; letter-spacing:0.06em; text-transform:uppercase; margin-top:14px; }

.cq-nav { position:fixed; bottom:0; left:0; right:0; background:var(--color-background); border-top:1px solid var(--border-subtle); padding:16px 24px; z-index:100; }
.cq-nav-inner { max-width:600px; margin:0 auto; display:flex; gap:12px; align-items:center; }
.cq-spacer { flex:1; }

.cq-btn-primary { background:var(--cq-color); color:#fff; border:none; padding:13px 26px; font-size:0.9rem; font-weight:800; letter-spacing:0.1em; text-transform:uppercase; cursor:pointer; transition:filter 160ms,transform 160ms; display:inline-flex; align-items:center; gap:8px; flex-shrink:0; }
.cq-btn-primary:hover:not(:disabled) { filter:brightness(1.1); transform:translateY(-1px); }
.cq-btn-primary:disabled { opacity:0.45; cursor:not-allowed; }
.cq-btn-ghost { background:transparent; color:var(--color-muted-foreground); border:1px solid var(--border-medium); padding:13px 20px; font-size:0.85rem; font-weight:700; letter-spacing:0.08em; text-transform:uppercase; cursor:pointer; transition:color 160ms; flex-shrink:0; }
.cq-btn-ghost:hover { color:var(--color-foreground); }
.cq-btn-primary.full, .cq-btn-ghost.full { width:100%; justify-content:center; text-align:center; }

/* Resultados */
.cq-results { max-width:600px; margin:0 auto; padding:32px 24px 120px; }
.cq-hero { text-align:center; padding:36px 0 28px; }
.cq-score-label { font-family:ui-monospace,monospace; font-size:0.6rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--color-muted-foreground); margin:18px 0 8px; }
.cq-nivel-icon { font-size:1.5rem; margin-bottom:6px; display:block; }
.cq-hero-nivel { font-size:2.25rem; font-weight:900; letter-spacing:0.04em; text-transform:uppercase; line-height:1.05; margin-bottom:8px; }
.cq-hero-sub { font-size:0.8125rem; color:var(--color-muted-foreground); }

.cq-metrics { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:28px; }
.cq-metric { background:var(--color-card); border:1px solid var(--border-subtle); border-top:1px solid rgba(var(--cq-rgb),0.35); padding:20px 16px; text-align:center; }
.cq-metric-val { font-size:1.75rem; font-weight:800; line-height:1; margin-bottom:6px; }
.cq-metric-lbl { font-family:ui-monospace,monospace; font-size:0.58rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--color-muted-foreground); }

.cq-sec-title { font-family:ui-monospace,monospace; font-size:0.62rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--color-muted-foreground); padding-bottom:10px; border-bottom:1px solid var(--border-subtle); margin:28px 0 14px; }

.cq-aviso { border:1px solid rgba(var(--cq-rgb),0.35); background:rgba(var(--cq-rgb),0.08); border-radius:14px; padding:16px 18px; margin:0 0 20px; }
.cq-aviso.alerta { border-color:rgba(239,68,68,0.45); background:rgba(239,68,68,0.08); }
.cq-aviso-titulo { font-weight:700; font-size:0.92rem; margin-bottom:4px; }
.cq-aviso-texto { font-size:0.84rem; line-height:1.55; color:var(--color-muted-foreground); margin:0; }
.cq-aviso-tel { display:inline-block; margin-top:10px; font-weight:800; font-size:1.05rem; color:#ef4444; text-decoration:none; }

.cq-rec { background:var(--color-card); border:1px solid var(--border-subtle); border-left:3px solid var(--cq-color); padding:18px 20px; margin-bottom:8px; }
.cq-rec-top { display:flex; align-items:center; gap:12px; margin-bottom:6px; }
.cq-rec-icon { font-size:1.25rem; }
.cq-rec-name { font-size:1.05rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; flex:1; }
.cq-rec-desc { font-size:0.84rem; color:var(--color-muted-foreground); line-height:1.5; margin:0; }

.cq-badge { font-family:ui-monospace,monospace; font-size:0.56rem; letter-spacing:0.1em; text-transform:uppercase; padding:3px 9px; flex-shrink:0; border:1px solid var(--border-subtle); }
.cq-badge-high { background:rgba(var(--cq-rgb),0.1); color:var(--cq-color); border-color:rgba(var(--cq-rgb),0.25); }
.cq-badge-med  { background:rgba(245,158,11,0.1); color:#d97706; border-color:rgba(245,158,11,0.25); }
.cq-badge-def  { background:var(--surface-1); color:var(--color-muted-foreground); }

.cq-tip { display:flex; align-items:flex-start; gap:12px; padding:12px 0; border-bottom:1px solid var(--border-subtle); }
.cq-tip:last-child { border-bottom:none; }
.cq-tip-icon { font-size:0.95rem; flex-shrink:0; margin-top:1px; }
.cq-tip-text { font-size:0.84rem; color:var(--color-muted-foreground); line-height:1.55; }

.cq-lista { margin:0; padding-left:20px; color:var(--color-muted-foreground); font-size:0.86rem; line-height:1.8; }

.cq-cta { display:flex; flex-direction:column; gap:10px; margin-top:32px; }
.cq-spinner { width:15px; height:15px; border:2px solid rgba(255,255,255,0.35); border-top-color:#fff; border-radius:50%; animation:cqSpin 0.7s linear infinite; display:inline-block; }

.cq-toast { position:fixed; bottom:92px; left:50%; transform:translateX(-50%) translateY(12px); background:var(--color-card); border:1px solid var(--border-medium); padding:9px 20px; font-size:0.75rem; opacity:0; transition:opacity 250ms,transform 250ms; pointer-events:none; white-space:nowrap; z-index:200; }
.cq-toast.show { opacity:1; transform:translateX(-50%) translateY(0); }
.cq-toast.success { border-color:rgba(var(--cq-rgb),0.35); color:var(--cq-color); }
.cq-toast.error   { border-color:rgba(239,68,68,0.35); color:#ef4444; }
